---
/**
 * Common misconceptions and the truth, side by side.
 *   <MythReality rows={[{ myth: 'Testing is just executing tests', reality: 'It includes many other activities' }]} />
 */
interface Row { myth: string; reality: string; }
interface Props { rows: Row[]; }
const { rows } = Astro.props;
---
<div class="myths">
  {rows.map((r) => (
    <div class="myths__row">
      <p class="myths__myth"><span class="myths__tag">✗ Myth</span>{r.myth}</p>
      <span class="myths__arrow" aria-hidden="true">→</span>
      <p class="myths__reality"><span class="myths__tag">✓ Reality</span>{r.reality}</p>
    </div>
  ))}
</div>

<style>
  .myths { display: grid; gap: 0.75rem; margin: 1rem 0; }
  .myths__row { display: grid; grid-template-columns: 1fr 2rem 1fr; align-items: stretch; }
  .myths p { margin: 0; padding: 0.8rem 1rem; border-radius: 12px; display: grid; gap: 0.25rem; }
  .myths__myth { background: var(--pink-tint); color: var(--charcoal); }
  .myths__reality { background: var(--success-tint); color: var(--charcoal); }
  .myths__tag { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .myths__myth .myths__tag { color: var(--pink-dark); }
  .myths__reality .myths__tag { color: #17663f; }
  .myths__arrow { display: grid; place-items: center; font-size: 1.3rem; font-weight: 700; color: var(--grey); }
  @media (max-width: 40rem) {
    .myths__row { grid-template-columns: 1fr; gap: 0.25rem; }
    .myths__arrow { transform: rotate(90deg); line-height: 1; }
  }
</style>
