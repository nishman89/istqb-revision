---
/**
 * The seven testing principles as numbered cards (readable on phones, unlike a drawn diagram).
 * Each card links to its principle's topic further down the page.
 */
import GithubSlugger from 'github-slugger';
interface Item { heading: string; title: string; sub?: string; }
interface Props { items: Item[]; }
const slugger = new GithubSlugger();
const items = Astro.props.items.map((it, i) => ({ ...it, n: i + 1, href: `#${slugger.slug(it.heading)}` }));
---
<ol class="principles" aria-label="The seven testing principles">
  {items.map((it) => (
    <li>
      <a class="principle" href={it.href} data-testid={`principle-card-${it.n}`}>
        <span class="principle__n" aria-hidden="true">{it.n}</span>
        <span class="principle__text">
          <span class="principle__title">{it.title}</span>
          {it.sub && <span class="principle__sub">{it.sub}</span>}
        </span>
        <span class="principle__go" aria-hidden="true">→</span>
      </a>
    </li>
  ))}
</ol>

<style>
  .principles { list-style: none; margin: 1rem 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  .principles li { margin: 0; }
  .principle { display: flex; align-items: center; gap: 0.9rem; height: 100%; padding: 0.85rem 1rem; background: var(--surface); border-radius: 14px; box-shadow: var(--shadow); border-left: 5px solid var(--pink); color: var(--charcoal); text-decoration: none; }
  .principles li:nth-child(even) .principle { border-left-color: var(--charcoal); }
  .principle:hover { background: var(--pink-tint); }
  .principle__n { flex: none; display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--pink); color: #fff; font: 700 1.15rem var(--font-head); }
  .principles li:nth-child(even) .principle__n { background: var(--charcoal); }
  .principle__text { display: grid; gap: 0.1rem; }
  .principle__title { font-weight: 700; line-height: 1.3; }
  .principle__sub { font-size: 0.9rem; color: var(--grey); }
  .principle__go { margin-left: auto; color: var(--pink-dark); font-weight: 700; }
  @media (max-width: 40rem) { .principles { grid-template-columns: 1fr; } }
</style>
