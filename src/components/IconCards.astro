---
/**
 * A grid of cards, each with an icon, a title and short points.
 * Good for grouped examples, e.g. product risks by quality characteristic.
 *
 *   <IconCards items={[{ icon: '⚡', title: 'Performance', points: ['Slow response time'] }]} />
 */
interface Item { icon: string; title: string; text?: string; points?: string[]; }
interface Props { items: Item[]; }
const { items } = Astro.props;
const cols = ({ 1: 1, 2: 2, 3: 3, 4: 2, 5: 3, 6: 3 } as Record<number, number>)[items.length] ?? 3;
---
<ul class="icon-cards" style={`--cols: ${cols}`}>
  {items.map((it, i) => (
    <li class:list={['icon-card', { 'icon-card--dark': i % 2 === 1 }]}>
      <span class="icon-card__icon" aria-hidden="true">{it.icon}</span>
      <span class="icon-card__title">{it.title}</span>
      {it.text && <span class="icon-card__text">{it.text}</span>}
      {it.points && <ul>{it.points.map((p) => <li>{p}</li>)}</ul>}
    </li>
  ))}
</ul>

<style>
  .icon-cards { list-style: none; padding: 0; margin: 1rem 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  .icon-card {
    flex: 0 1 calc((100% - (var(--cols) - 1) * 0.75rem) / var(--cols)); margin: 0;
    display: flex; flex-direction: column; gap: 0.3rem; padding: 1rem 1.1rem 1.1rem;
    background: var(--surface); border-radius: 14px; box-shadow: var(--shadow); border-left: 5px solid var(--pink);
  }
  .icon-card--dark { border-left-color: var(--charcoal); }
  .icon-card__icon { font-size: 1.6rem; line-height: 1; }
  .icon-card__title { font: 700 1.05rem/1.3 var(--font-head); }
  .icon-card__text { color: var(--grey); font-size: 0.95rem; }
  .icon-card ul { margin: 0.1rem 0 0; padding-left: 1.1rem; font-size: 0.95rem; color: var(--grey); display: grid; gap: 0.15rem; }
  .icon-card ul li::marker { color: var(--pink); }
  @media (max-width: 40rem) { .icon-card { flex-basis: 100%; } }
</style>
