---
/** Requirements ⇄ test cases ⇄ defects, with labelled two-way links. Stacks vertically on phones. */
const nodes = [
  { title: 'Requirements', sub: 'what it must do' },
  { title: 'Test cases', sub: 'how we check it' },
  { title: 'Defects', sub: 'what went wrong' },
];
const links = [
  { fwd: 'covered by', back: 'traces to' },
  { fwd: 'finds', back: 'traced back to' },
];
---
<figure class="tf">
  <div class="tf__row">
    {nodes.map((n, i) => (
      <>
        <div class:list={['tf__node', i % 2 ? 'tf__node--dark' : 'tf__node--pink']}><strong>{n.title}</strong><span>{n.sub}</span></div>
        {i < links.length && (
          <div class="tf__link" aria-label={`${links[i].fwd} / ${links[i].back}`}>
            <span class="tf__fwd">{links[i].fwd} →</span>
            <span class="tf__back">← {links[i].back}</span>
          </div>
        )}
      </>
    ))}
  </div>
  <figcaption>Links in both directions: from a requirement to its tests and defects, and from a defect back to its requirement (CTFL 1.4.4)</figcaption>
</figure>

<style>
  .tf { margin: 1rem 0; padding: 1.25rem; background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); }
  .tf figcaption { margin-top: 0.9rem; text-align: center; font-size: 0.9rem; color: var(--grey); }
  .tf__row { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: center; gap: 0.5rem; }
  .tf__node { display: grid; gap: 0.15rem; padding: 1rem 0.75rem; border-radius: 12px; text-align: center; color: #fff; }
  .tf__node span { font-size: 0.88rem; opacity: 0.92; }
  .tf__node--pink { background: var(--pink); }
  .tf__node--dark { background: var(--charcoal); }
  .tf__link { display: grid; gap: 0.3rem; justify-items: center; font-size: 0.82rem; font-weight: 700; color: var(--grey); white-space: nowrap; }
  .tf__fwd { color: var(--pink-dark); }
  @media (max-width: 40rem) {
    .tf__row { grid-template-columns: 1fr; }
    .tf__link { grid-auto-flow: column; gap: 1rem; padding: 0.2rem 0; }
    .tf__fwd::after { content: ' ↓'; } .tf__back::before { content: '↑ '; }
    .tf__fwd, .tf__back { font-size: 0.85rem; }
  }
</style>
