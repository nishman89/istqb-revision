---
/** Collapsible box holding the full syllabus wording behind a slide. */
---
<details class="syllabus">
  <summary>What the syllabus says</summary>
  <div class="body">
    <slot />
    <p class="source">Source: <a href="https://istqb.org/certifications/certified-tester-foundation-level-ctfl-v4-0" target="_blank" rel="noopener">ISTQB® CTFL v4.0 syllabus</a> © ISTQB®</p>
  </div>
</details>

<style>
  .syllabus { margin: 1rem 0 0; border-left: 4px solid var(--pink); background: var(--pink-tint); border-radius: 0 10px 10px 0; }
  summary { cursor: pointer; padding: 0.6rem 1rem; font-weight: 700; color: var(--pink-dark); }
  .body { padding: 0 1rem 0.5rem; font-size: 0.95rem; }
  .body :global(p) { margin: 0 0 0.6rem; }
  .source { font-size: 0.8rem; color: var(--grey); margin-top: 0.5rem !important; }
</style>
