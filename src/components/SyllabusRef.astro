---
/** Shows which part of the CTFL v4.0 syllabus a topic covers. */
interface Props { ref?: string; beyond?: boolean; }
const { ref, beyond = false } = Astro.props;
---
{beyond
  ? <p class="ref ref--beyond"><span>Beyond the syllabus</span> Useful background — not examined</p>
  : <p class="ref"><span>Syllabus</span> CTFL v4.0 · Section {ref}</p>}

<style>
  .ref { display: inline-flex; align-items: center; gap: 0.5rem; margin: 0 0 1rem; font-size: 0.85rem; font-weight: 600; color: var(--grey); }
  .ref span { background: var(--pink); color: #fff; padding: 0.1rem 0.6rem; border-radius: 999px; font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .ref--beyond span { background: var(--charcoal); }
</style>
