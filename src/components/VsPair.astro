---
/**
 * Two contrasting ideas side by side, each with a short meaning and an example.
 *   <VsPair left={{ title, meaning, example }} right={{ ... }} />
 */
interface Side { title: string; meaning: string; example?: string; }
interface Props { left: Side; right: Side; }
const { left, right } = Astro.props;
---
<div class="vs-pair">
  {[left, right].map((s, i) => (
    <>
      {i === 1 && <span class="vs-pair__vs" aria-hidden="true">vs</span>}
      <section class:list={['vs-pair__card', i ? 'vs-pair__card--dark' : 'vs-pair__card--pink']}>
        <h4>{s.title}</h4>
        <p class="vs-pair__meaning" set:html={s.meaning} />
        {s.example && <p class="vs-pair__example"><span>Example</span> {s.example}</p>}
      </section>
    </>
  ))}
</div>

<style>
  .vs-pair { display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch; gap: 0.6rem; margin: 0.9rem 0; }
  .vs-pair__card { display: flex; flex-direction: column; gap: 0.35rem; padding: 0.9rem 1.1rem; background: var(--surface); border-radius: 14px; box-shadow: var(--shadow); border-top: 5px solid var(--pink); }
  .vs-pair__card--dark { border-top-color: var(--charcoal); }
  .vs-pair .vs-pair__card h4 { margin: 0; font: 700 1.1rem var(--font-head); color: var(--charcoal); text-transform: none; letter-spacing: 0; }
  .vs-pair__meaning { margin: 0; }
  .vs-pair__example { margin: auto 0 0; padding-top: 0.5rem; border-top: 1px dashed var(--line); font-size: 0.93rem; color: var(--grey); }
  .vs-pair__example span { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--pink-dark); margin-right: 0.3rem; }
  .vs-pair__vs { align-self: center; font-weight: 700; color: var(--pink-dark); }
  @media (max-width: 40rem) { .vs-pair { grid-template-columns: 1fr; } .vs-pair__vs { justify-self: center; } }
</style>
