---
import type { Question } from '../content.config';
import QuestionBody from './QuestionBody.astro';
import { PASS_MARK, MINUTES_PER_K } from '../lib/site';

/**
 * Udemy-style quiz: answer everything, submit, then see a score and a full review
 * explaining why each option is right or wrong. Explanations are rendered at build
 * time and revealed by the client script after submission.
 */
interface Props { questions: Question[]; quizId: string; }
const { questions, quizId } = Astro.props;
const total = questions.length;
const passScore = Math.ceil(total * PASS_MARK);
const minutes = Math.ceil(questions.reduce((m, q) => m + MINUTES_PER_K[q.k], 0));
---
<section class="quiz" data-quiz-id={quizId} data-pass-mark={PASS_MARK}>
  <div class="card quiz-intro no-print">
    <dl>
      <div><dt>Questions</dt><dd>{total}</dd></div>
      <div><dt>To pass</dt><dd>{passScore} / {total} (65%)</dd></div>
      <div><dt>Suggested time</dt><dd>~{minutes} min</dd></div>
    </dl>
    <p class="last-attempt" hidden data-last-attempt></p>
  </div>

  <div class="results card card--dark" hidden data-results tabindex="-1">
    <div class="score">
      <span class="eyebrow" data-verdict-label></span>
      <p class="score__big"><span data-score></span><span class="score__of"> / {total}</span></p>
      <p class="score__pct" data-percent></p>
    </div>
    <div class="results__actions no-print">
      <label class="toggle"><input type="checkbox" data-only-wrong /> Show only questions I got wrong</label>
      <button class="btn" type="button" data-retake>Retake quiz</button>
    </div>
  </div>

  <form class="questions" data-form novalidate>
    <ol>
      {questions.map((q, i) => (
        <li class="q card" data-question={q.id} data-answer={q.answer.join(',')} data-select={q.select}>
          <header class="q__head">
            <span class="q__num">Question {i + 1}<span class="muted"> of {total}</span></span>
            <span class="q__tags">
              <span class="pill">Section {q.ref}</span>
              <span class="pill pill--dark" title="Knowledge level">{q.k}</span>
            </span>
          </header>
          <QuestionBody blocks={q.blocks} label={`question ${i + 1}`} />
          <fieldset>
            <legend class="q__instruction">Select {q.select === 2 ? 'TWO options' : 'ONE option'}</legend>
            {q.options.map((o) => (
              <label class="opt" data-option={o.key}>
                <input type={q.select === 2 ? 'checkbox' : 'radio'} name={q.id} value={o.key} />
                <span class="opt__key">{o.key}</span>
                <span class="opt__text">{o.text}</span>
                <span class="opt__flag" aria-hidden="true"></span>
              </label>
            ))}
          </fieldset>
          <div class="review" hidden data-review>
            <p class="review__verdict" data-verdict></p>
            {q.explanation.intro && <p class="review__intro">{q.explanation.intro}</p>}
            <ul class="review__options">
              {q.options.map((o) => q.explanation.options[o.key] && (
                <li data-explain={o.key}><strong>{o.key})</strong> {q.explanation.options[o.key]}</li>
              ))}
            </ul>
            <p class="review__source muted">ISTQB Sample Exam {q.exam}, question {q.n} · {q.lo}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="submit-bar no-print" data-submit-bar>
      <span><strong data-answered>0</strong> of {total} answered</span>
      <button class="btn" type="submit">Submit answers</button>
    </div>
  </form>
</section>

<script>
  import { getQuiz, saveQuizAttempt, type QuizAttempt } from '../lib/progress';

  for (const quiz of document.querySelectorAll<HTMLElement>('[data-quiz-id]')) {
    const id = quiz.dataset.quizId!;
    const passMark = Number(quiz.dataset.passMark);
    const form = quiz.querySelector<HTMLFormElement>('[data-form]')!;
    const items = [...quiz.querySelectorAll<HTMLElement>('[data-question]')];
    const results = quiz.querySelector<HTMLElement>('[data-results]')!;
    const answeredEl = quiz.querySelector<HTMLElement>('[data-answered]')!;
    const onlyWrong = quiz.querySelector<HTMLInputElement>('[data-only-wrong]')!;

    const chosen = (item: HTMLElement) =>
      [...item.querySelectorAll<HTMLInputElement>('input:checked')].map((i) => i.value).sort();
    const isAnswered = (item: HTMLElement) => chosen(item).length === Number(item.dataset.select);

    const updateCount = () => {
      answeredEl.textContent = String(items.filter(isAnswered).length);
    };

    // "Select TWO" questions: stop a third box being ticked.
    form.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      const item = input.closest<HTMLElement>('[data-question]')!;
      if (input.type === 'checkbox' && chosen(item).length > Number(item.dataset.select)) input.checked = false;
      updateCount();
    });

    function mark(answers: Record<string, string[]>) {
      let score = 0;
      for (const item of items) {
        const correct = item.dataset.answer!.split(',');
        const picked = answers[item.dataset.question!] ?? [];
        const right = picked.length === correct.length && picked.every((k) => correct.includes(k));
        if (right) score++;
        item.classList.add(right ? 'is-right' : 'is-wrong');
        item.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
          input.checked = picked.includes(input.value);
          input.disabled = true;
          const label = input.closest<HTMLElement>('.opt')!;
          label.classList.toggle('is-correct', correct.includes(input.value));
          label.classList.toggle('is-picked-wrong', input.checked && !correct.includes(input.value));
        });
        item.querySelectorAll<HTMLElement>('[data-explain]').forEach((li) => {
          li.classList.toggle('is-correct', correct.includes(li.dataset.explain!));
          li.classList.toggle('is-picked', picked.includes(li.dataset.explain!));
        });
        const verdict = item.querySelector<HTMLElement>('[data-verdict]')!;
        verdict.textContent = right
          ? 'Correct!'
          : picked.length
            ? `Not quite. You chose ${picked.join(' and ')}; the answer is ${correct.join(' and ')}.`
            : `Not answered. The answer is ${correct.join(' and ')}.`;
        item.querySelector<HTMLElement>('[data-review]')!.hidden = false;
      }
      return score;
    }

    function showResults(attempt: QuizAttempt) {
      quiz.classList.add('is-marked');
      quiz.querySelector('[data-submit-bar]')!.setAttribute('hidden', '');
      results.hidden = false;
      results.classList.toggle('is-pass', attempt.passed);
      quiz.querySelector('[data-score]')!.textContent = String(attempt.score);
      quiz.querySelector('[data-percent]')!.textContent = `${attempt.percent}% · pass mark 65%`;
      quiz.querySelector('[data-verdict-label]')!.textContent = attempt.passed ? 'Pass - well done' : 'Not a pass yet - review below';
      results.focus();
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const unanswered = items.filter((i) => !isAnswered(i)).length;
      if (unanswered && !confirm(`You have ${unanswered} unanswered question(s). Submit anyway?`)) return;
      const answers = Object.fromEntries(items.map((i) => [i.dataset.question!, chosen(i)]));
      const score = mark(answers);
      const percent = Math.round((score / items.length) * 100);
      const attempt: QuizAttempt = {
        score, total: items.length, percent, passed: score / items.length >= passMark,
        date: new Date().toISOString(), answers,
      };
      saveQuizAttempt(id, attempt);
      showResults(attempt);
    });

    quiz.querySelector('[data-retake]')!.addEventListener('click', () => {
      quiz.classList.remove('is-marked', 'only-wrong');
      onlyWrong.checked = false;
      results.hidden = true;
      quiz.querySelector('[data-submit-bar]')!.removeAttribute('hidden');
      for (const item of items) {
        item.classList.remove('is-right', 'is-wrong');
        item.querySelector<HTMLElement>('[data-review]')!.hidden = true;
        item.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
          input.checked = false;
          input.disabled = false;
          input.closest('.opt')!.classList.remove('is-correct', 'is-picked-wrong');
        });
      }
      updateCount();
      quiz.scrollIntoView({ behavior: 'smooth' });
    });

    onlyWrong.addEventListener('change', () => quiz.classList.toggle('only-wrong', onlyWrong.checked));

    // Offer the previous attempt, if there is one.
    const record = getQuiz(id);
    const lastEl = quiz.querySelector<HTMLElement>('[data-last-attempt]')!;
    if (record) {
      const { last, best } = record;
      const when = new Date(last.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
      lastEl.hidden = false;
      lastEl.innerHTML = `Last attempt: <strong>${last.percent}%</strong> on ${when} · Best: <strong>${best.percent}%</strong> · ${record.attempts} attempt(s) <button type="button" class="link-btn">Review last attempt</button>`;
      lastEl.querySelector('button')!.addEventListener('click', () => {
        mark(last.answers);
        showResults(last);
      });
    }
    updateCount();
  }
</script>

<style>
  .quiz { display: grid; gap: 1.25rem; }
  .quiz-intro dl { display: flex; flex-wrap: wrap; gap: 2rem; margin: 0; }
  .quiz-intro dt { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--pink); }
  .quiz-intro dd { margin: 0; font: 700 1.4rem var(--font-head); }
  .last-attempt { margin: 1rem 0 0; padding-top: 1rem; border-top: 1px solid var(--line); }
  .last-attempt :global(.link-btn) { background: none; border: 0; color: var(--pink-dark); font: inherit; font-weight: 700; text-decoration: underline; cursor: pointer; margin-left: 0.5rem; }

  .results { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; scroll-margin-top: 6rem; border-left: 8px solid var(--pink); }
  .results.is-pass { border-left-color: #3ccf8e; }
  .score__big { font: 700 3.5rem/1 var(--font-head); margin: 0.25rem 0; }
  .score__of { font-size: 1.5rem; color: #bbb; }
  .score__pct { margin: 0; color: var(--pink-soft); font-weight: 700; }
  .results__actions { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
  .toggle { display: flex; gap: 0.5rem; align-items: center; cursor: pointer; }

  .questions ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .q { border-left: 6px solid transparent; }
  .q.is-right { border-left-color: var(--success); }
  .q.is-wrong { border-left-color: var(--pink); }
  .only-wrong .q.is-right { display: none; }
  .q__head { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
  .q__num { font: 700 1.1rem var(--font-head); }
  .q__tags { display: flex; gap: 0.4rem; }

  fieldset { border: 0; padding: 0; margin: 0.5rem 0 0; display: grid; gap: 0.5rem; }
  .q__instruction { font-size: 0.85rem; font-weight: 700; color: var(--grey); margin-bottom: 0.5rem; }
  .opt { display: grid; grid-template-columns: auto 2rem 1fr auto; gap: 0.75rem; align-items: center; padding: 0.7rem 1rem; border: 2px solid var(--line); border-radius: 12px; cursor: pointer; transition: border-color 0.15s, background 0.15s; }
  .opt:hover { border-color: var(--pink-soft); }
  .opt:has(input:checked) { border-color: var(--pink); background: var(--pink-tint); }
  .opt input { accent-color: var(--pink); width: 1.1rem; height: 1.1rem; }
  .opt__key { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--charcoal); color: #fff; font-weight: 700; }
  .opt__text { white-space: pre-line; }
  .is-marked .opt { cursor: default; }
  .opt.is-correct { border-color: var(--success); background: var(--success-tint); }
  .opt.is-correct .opt__flag::after { content: '✓ Correct answer'; color: var(--success); font-weight: 700; font-size: 0.85rem; }
  .opt.is-picked-wrong { border-color: var(--pink); background: var(--pink-tint); }
  .opt.is-picked-wrong .opt__flag::after { content: '✗ Your answer'; color: var(--pink-dark); font-weight: 700; font-size: 0.85rem; }

  .review { margin-top: 1rem; padding: 1rem 1.25rem; background: var(--bg); border-radius: 12px; }
  .review__verdict { font: 700 1.1rem var(--font-head); margin: 0 0 0.5rem; }
  .is-right .review__verdict { color: var(--success); }
  .is-wrong .review__verdict { color: var(--pink-dark); }
  .review__intro { white-space: pre-line; }
  .review__options { padding-left: 0; list-style: none; display: grid; gap: 0.5rem; }
  .review__options li { padding: 0.5rem 0.75rem; border-radius: 8px; border-left: 4px solid var(--line); background: var(--surface); }
  .review__options li.is-correct { border-left-color: var(--success); }
  .review__options li.is-picked:not(.is-correct) { border-left-color: var(--pink); }
  .review__source { font-size: 0.8rem; margin: 0.75rem 0 0; }

  .submit-bar { position: sticky; bottom: 1rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; background: var(--charcoal); color: #fff; padding: 0.75rem 0.75rem 0.75rem 1.5rem; border-radius: 999px; box-shadow: var(--shadow); margin-top: 1.25rem; }
  @media (max-width: 40rem) {
    .opt { grid-template-columns: auto 2rem 1fr; }
    .opt__flag { grid-column: 1 / -1; }
  }
</style>
