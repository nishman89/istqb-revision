---
/** Door state transition diagram with three states. */
import Figure from '../Figure.astro';
// unique per copy, so the diagram can appear twice on a page (e.g. in a topic and an exercise answer)
const id = `ds-${Math.random().toString(36).slice(2, 8)}`;
---
<Figure caption="A door modelled with three states and four valid transitions (CTFL 4.2.4)">
  <svg viewBox="0 0 820 280" role="img" aria-label="Door state transition diagram">
    <defs><marker id={id} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0L10 5L0 10z" fill="#d42a57"/></marker></defs>
    <rect class="b-pink" x="40" y="180" width="180" height="60" rx="30"/><text class="t" x="130" y="210">OPEN</text>
    <rect class="b-dark" x="480" y="180" width="260" height="60" rx="30"/><text class="t" x="610" y="210">CLOSED UNLOCKED</text>
    <rect class="b-dark" x="480" y="20" width="260" height="60" rx="30"/><text class="t" x="610" y="50">CLOSED LOCKED</text>
    <line class="ln-pink" x1="222" y1="196" x2="476" y2="196" marker-end={`url(#${id})`}/>
    <text class="t-dark" x="350" y="180" style="font-size:14px">close door</text>
    <line class="ln-pink" x1="476" y1="226" x2="222" y2="226" marker-end={`url(#${id})`}/>
    <text class="t-dark" x="350" y="250" style="font-size:14px">open door</text>
    <line class="ln-pink" x1="580" y1="176" x2="580" y2="84" marker-end={`url(#${id})`}/>
    <text class="t-dark" x="530" y="130" style="font-size:14px">lock</text>
    <line class="ln-pink" x1="640" y1="84" x2="640" y2="176" marker-end={`url(#${id})`}/>
    <text class="t-dark" x="694" y="130" style="font-size:14px">unlock</text>
  </svg>
</Figure>
