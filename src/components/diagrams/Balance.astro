---
/** Test automation: benefits weighed against risks. */
import Figure from '../Figure.astro';
---
<Figure caption="Buying a tool doesn't guarantee success — weigh the benefits against the risks, and allow effort to introduce, maintain and train people on it (CTFL 6.2)">
  <svg viewBox="0 0 820 300" role="img" aria-label="A balance with benefits on one side and risks on the other">
    <rect x="40" y="20" width="320" height="130" rx="16" class="b-tint"/>
    <text class="t-lbl" x="200" y="50" style="font-size:15px">BENEFITS</text>
    {['Time saved · consistency', 'Objective measures', 'Faster feedback'].map((t, i) => <text class="t-dark" x="200" y={82 + i * 24} style="font-size:15px;font-weight:600">{t}</text>)}
    <rect x="460" y="40" width="320" height="130" rx="16" class="b-white"/>
    <text class="t-lbl" x="620" y="70" style="font-size:15px;fill:#2d2a2b">RISKS</text>
    {['Unrealistic expectations', 'Over-reliance on the tool', 'Vendor dependency'].map((t, i) => <text class="t-dark" x="620" y={102 + i * 24} style="font-size:15px;font-weight:600">{t}</text>)}
    <line x1="120" y1="172" x2="700" y2="186" stroke="#2d2a2b" stroke-width="8" stroke-linecap="round"/>
    <path d="M410 182 L360 270 H460 Z" class="b-pink"/>
  </svg>
</Figure>
