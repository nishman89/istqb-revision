---
/** Root cause analysis with the 5 Whys: each answer steps down to the next question until the root cause is reached. */
import Figure from '../Figure.astro';
const whys = [
  'Error in the calculation of the OAP discount',
  'Developer entered the OAP discount as 10% rather than 20%',
  'Specification states 10% instead of 20%',
  'Miscommunication between School CEO and Product Owner',
  'No review of the specification',
];
---
<Figure caption="The 5 Whys: keep asking why until you reach a cause you can fix - here, adding a specification review prevents similar defects (CTFL 1.2.3)">
  <svg viewBox="0 0 820 400" role="img" aria-label="5 Whys staircase from failure to root cause">
    <rect class="b-dark" x="10" y="10" width="800" height="48" rx="10"/>
    <text class="t-lbl" x="80" y="38" style="fill:#f4b6c5">FAILURE</text>
    <text class="t" x="440" y="34">Customers over 60 are overcharged for their lessons</text>
    {whys.map((w, i) => {
      const x = 30 + i * 42, y = 76 + i * 56, last = i === whys.length - 1;
      return (
        <g>
          <path class="ln" d={`M${x + 8} ${y - 16} v${30}`} />
          <rect class={last ? 'b-pink' : 'b-white'} x={x + 24} y={y} width={800 - x - 34} height="44" rx="10"/>
          <circle cx={x + 8} cy={y + 22} r="16" class={last ? 'b-pink' : 'b-dark'}/>
          <text class="t" x={x + 8} y={y + 22} style="font-size:13px">?</text>
          <text class={last ? 't-sm-w' : 't-lbl'} x={x + 72} y={y + 26} style="font-size:13px;font-weight:700">WHY #{i + 1}</text>
          <text class={last ? 't' : 't-dark'} x={x + 116} y={y + 22} style="text-anchor:start;font-size:15px">{w}</text>
        </g>
      );
    })}
    <rect class="b-dark" x="680" y="350" width="130" height="34" rx="17"/>
    <text class="t" x="745" y="367" style="font-size:13px">ROOT CAUSE</text>
  </svg>
</Figure>
