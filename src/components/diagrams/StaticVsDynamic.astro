---
/** Static vs dynamic testing. */
import Figure from '../Figure.astro';
import Icon from '../Icon.astro';
---
<Figure caption="Static testing finds defects directly; dynamic testing finds failures, then defects through analysis - they complement each other (CTFL 3.1.3)">
  <svg viewBox="0 0 820 220" role="img" aria-label="Static versus dynamic testing">
    <rect class="b-dark" x="10" y="10" width="390" height="200" rx="16"/>
    <Icon name="eye" size={40} x={36} y={30} fill="#fff"/>
    <text class="t" x="230" y="50" style="font-size:22px">Static testing</text>
    <text class="t" x="205" y="104" style="font-size:15px">Code is NOT executed</text>
    <text class="t-sm-w" x="205" y="134">Reviews and static analysis</text>
    <text class="t-sm-w" x="205" y="160">Finds defects directly</text>
    <text class="t-sm-w" x="205" y="186">Works on any work product</text>
    <rect class="b-pink" x="420" y="10" width="390" height="200" rx="16"/>
    <Icon name="play" size={40} x={446} y={30} fill="#fff"/>
    <text class="t" x="640" y="50" style="font-size:22px">Dynamic testing</text>
    <text class="t" x="615" y="104" style="font-size:15px">Code IS executed</text>
    <text class="t-sm-w" x="615" y="134">Test techniques derive test cases</text>
    <text class="t-sm-w" x="615" y="160">Causes failures → defects found by analysis</text>
    <text class="t-sm-w" x="615" y="186">Needs executable software</text>
  </svg>
</Figure>
