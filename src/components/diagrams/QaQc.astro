---
/** QA vs QC, with testing as part of QC. */
import Figure from '../Figure.astro';
---
<Figure caption="Testing is a form of quality control; quality assurance improves the process that builds the product (CTFL 1.2.2)">
  <svg viewBox="0 0 820 250" role="img" aria-label="Quality assurance and quality control">
    <rect class="b-dark" x="10" y="10" width="390" height="230" rx="16"/>
    <text class="t" x="205" y="44" style="font-size:22px">Quality Assurance (QA)</text>
    <text class="t-sm-w" x="205" y="72">process-oriented · preventive</text>
    <text class="t" x="205" y="122" style="font-size:15px">Improve the process →</text>
    <text class="t" x="205" y="146" style="font-size:15px">a good process gives a good product</text>
    <text class="t-sm-w" x="205" y="196">Everyone's responsibility</text>
    <rect class="b-pink" x="420" y="10" width="390" height="230" rx="16"/>
    <text class="t" x="615" y="44" style="font-size:22px">Quality Control (QC)</text>
    <text class="t-sm-w" x="615" y="72">product-oriented · corrective</text>
    <rect x="470" y="98" width="290" height="58" rx="29" fill="#fff"/>
    <text class="t-dark" x="615" y="127" style="font-size:18px">Testing</text>
    <text class="t-sm-w" x="615" y="186">also: formal methods, simulation,</text>
    <text class="t-sm-w" x="615" y="206">prototyping</text>
  </svg>
</Figure>
