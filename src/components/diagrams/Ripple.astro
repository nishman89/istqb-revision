---
/** How far one change can reach: the reason regression testing is needed (CTFL 2.2.3). */
import Figure from '../Figure.astro';
const rings = [['Connected systems and environment', 168, 'b-light', 't-dark'], ['Other components', 122, 'b-soft', 't-dark'], ['Same component', 78, 'b-pink', 't'], ['Change', 36, 'b-dark', 't']] as const;
---
<Figure caption="How far can one change reach? A change, even a confirmed fix, can affect the same component, other components, connected systems and the environment (CTFL 2.2.3)">
  <svg viewBox="0 0 400 350" role="img" aria-label="Ripple effect of a change: same component, other components, connected systems and environment">
    {rings.map(([, r, b]) => <circle cx="200" cy="175" r={r} class={b}/>)}
    {rings.map(([l, r, , t], i) => <text class={t} x="200" y={i === 3 ? 175 : 175 - r + 21} style="font-size:15px">{l}</text>)}
  </svg>
</Figure>
