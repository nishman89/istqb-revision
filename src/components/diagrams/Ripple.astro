---
/** How far a change can ripple - why regression testing matters. */
import Figure from '../Figure.astro';
const rings = [['Connected systems & environment', 150, 'b-light', 't-dark'], ['Other components', 108, 'b-soft', 't-dark'], ['Same component', 68, 'b-pink', 't'], ['Change', 32, 'b-dark', 't']] as const;
---
<Figure caption="A change - even a confirmed fix - can have side effects well beyond the code that changed. Impact analysis shows how far to regression test (CTFL 2.2.3)">
  <svg viewBox="0 0 820 320" role="img" aria-label="Ripple effect of a change">
    {rings.map(([, r, b]) => <circle cx="250" cy="160" r={r} class={b}/>)}
    {rings.map(([l, r, , t], i) => <text class={t} x="250" y={i === 3 ? 160 : 160 - r + 18} style="font-size:13px">{l}</text>)}
    <rect class="b-white" x="450" y="40" width="350" height="110" rx="14"/>
    <text class="t-lbl" x="625" y="66">CONFIRMATION TESTING</text>
    <text class="t-dark" x="625" y="96">Is the original defect fixed?</text>
    <text class="t-sm" x="625" y="122">Re-run the tests that failed</text>
    <rect class="b-dark" x="450" y="170" width="350" height="110" rx="14"/>
    <text class="t-lbl" x="625" y="196" style="fill:#f4b6c5">REGRESSION TESTING</text>
    <text class="t" x="625" y="226">Did the change break anything else?</text>
    <text class="t-sm-w" x="625" y="252">A strong candidate for automation</text>
  </svg>
</Figure>
