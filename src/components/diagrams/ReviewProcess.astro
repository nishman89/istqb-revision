---
/** ISO/IEC 20246 generic review process. */
import Figure from '../Figure.astro';
const st = [['Planning', ''], ['Review', 'initiation'], ['Individual', 'review'], ['Communication', '& analysis'], ['Fixing &', 'reporting']];
---
<Figure caption="The review process — five activities from ISO/IEC 20246 (CTFL 3.2.2)">
  <svg viewBox="0 0 820 150" role="img" aria-label="Review process steps">
    <defs><marker id="rp-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="#5c5c5c"/></marker></defs>
    {st.map((s, i) => {
      const [l1, l2] = s;
      return (
        <g>
          <rect class={i % 2 ? 'b-dark' : 'b-pink'} x={10 + i * 164} y="20" width="144" height="100" rx="12"/>
          <text class="t-sm-w" x={82 + i * 164} y="44">{i + 1}</text>
          <text class="t" x={82 + i * 164} y={l2 ? 72 : 83} style="font-size:14px">{l1}</text>
          {l2 && <text class="t" x={82 + i * 164} y="94" style="font-size:14px">{l2}</text>}
          {i < 4 && <line class="ln" x1={156 + i * 164} y1="70" x2={172 + i * 164} y2="70" marker-end="url(#rp-a)"/>}
        </g>
      );
    })}
  </svg>
</Figure>
