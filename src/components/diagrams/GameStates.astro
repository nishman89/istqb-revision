---
/**
 * State transition diagram for a video game, drawn in the plain style of the ISTQB sample papers:
 * four identical circular states joined by smooth curved arrows with plain-English event labels.
 */
import Figure from '../Figure.astro';
// unique per copy, so the diagram can appear more than once on a page
const id = `gs-${Math.random().toString(36).slice(2, 8)}`;
const states = [
  { cx: 110, cy: 200, lines: ['Main', 'menu'] },
  { cx: 340, cy: 110, lines: ['Game', 'running'] },
  { cx: 570, cy: 200, lines: ['Game', 'paused'] },
  { cx: 340, cy: 330, lines: ['Game', 'over'] },
];
const labels: { x: number; y: number; lines: string[]; anchor?: string }[] = [
  { x: 176, y: 80, lines: ['Player clicks', '"Start"'] },
  { x: 504, y: 80, lines: ['Player clicks', '"Pause"'] },
  { x: 478, y: 236, lines: ['Player clicks', '"Resume"'] },
  { x: 328, y: 204, lines: ['Player loses a life', '[lives = 1]'], anchor: 'end' },
  { x: 214, y: 352, lines: ['Player clicks', '"Menu"'] },
  { x: 340, y: 440, lines: ['Player clicks "Quit"'] },
];
---
<Figure scroll caption="A video game modelled with four states and six valid transitions (CTFL 4.2.4)">
  <svg viewBox="0 0 680 470" role="img" aria-label="State transition diagram: main menu, game running, game paused and game over">
    <defs>
      <marker id={id} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M2 1L8 5L2 9" fill="none" stroke="#2d2a2b" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </marker>
    </defs>
    <g fill="none" stroke="#2d2a2b" stroke-width="1.6" stroke-linecap="round">
      <path d="M146 166 Q 190 108 284 106" marker-end={`url(#${id})`}/>
      <path d="M396 106 Q 490 108 534 166" marker-end={`url(#${id})`}/>
      <path d="M520 214 Q 460 188 390 140" marker-end={`url(#${id})`}/>
      <line x1="340" y1="164" x2="340" y2="272" marker-end={`url(#${id})`}/>
      <path d="M288 336 Q 190 330 146 238" marker-end={`url(#${id})`}/>
      <path d="M570 254 C 570 466, 110 466, 110 258" marker-end={`url(#${id})`}/>
    </g>
    {states.map((s) => (
      <g>
        <circle cx={s.cx} cy={s.cy} r="52" fill="#ffffff" stroke="#2d2a2b" stroke-width="1.8"/>
        {s.lines.map((l, i) => <text x={s.cx} y={s.cy - 9 + i * 19} text-anchor="middle" dominant-baseline="central" style="font-size:15px;font-weight:700;fill:#2d2a2b">{l}</text>)}
      </g>
    ))}
    {labels.map((l) => l.lines.map((line, i) => (
      <text x={l.x} y={l.y + i * 17} text-anchor={l.anchor ?? 'middle'} dominant-baseline="central" style="font-size:13.5px;font-weight:600;fill:#4a4a4a">{line}</text>
    )))}
  </svg>
</Figure>
