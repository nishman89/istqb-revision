---
/** Royce's waterfall: each stage cascades into the next. */
import Figure from '../Figure.astro';
const st = ['System requirements', 'Software requirements', 'Analysis', 'Program design', 'Coding', 'Testing', 'Operations'];
---
<Figure caption="Royce's waterfall model — a sequential SDLC where testing comes late (CTFL 2.1)">
  <svg viewBox="0 0 820 330" role="img" aria-label="Waterfall model stages">
    <defs><marker id="wf-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="#5c5c5c"/></marker></defs>
    {st.map((s, i) => (
      <g>
        <rect class={s === 'Testing' ? 'b-pink' : 'b-dark'} x={10 + i * 90} y={10 + i * 45} width="240" height="36" rx="8"/>
        <text class="t" x={130 + i * 90} y={28 + i * 45}>{s}</text>
        {i < 6 && <path class="ln" d={`M${252 + i * 90} ${28 + i * 45} h24 v26`} marker-end="url(#wf-a)"/>}
      </g>
    ))}
  </svg>
</Figure>
