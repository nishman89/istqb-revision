---
/**
 * State transition diagram for a TV (practice workbook example), in the same plain ISTQB style as GameStates:
 * three identical circular states and five valid transitions. The remote does nothing when the TV is off.
 */
import Figure from '../Figure.astro';
const id = `tv-${Math.random().toString(36).slice(2, 8)}`;
const states = [
  { cx: 120, cy: 170, label: 'Off' },
  { cx: 340, cy: 170, label: 'Standby' },
  { cx: 560, cy: 170, label: 'On' },
];
const labels = [
  { x: 230, y: 112, text: 'TV button' },
  { x: 230, y: 234, text: 'TV button' },
  { x: 450, y: 112, text: 'Remote' },
  { x: 450, y: 234, text: 'Remote' },
  { x: 340, y: 326, text: 'TV button' },
];
---
<Figure scroll caption="A TV with three states and five valid transitions. The remote does nothing when the TV is off">
  <svg viewBox="0 70 680 285" role="img" aria-label="State transition diagram: off, standby and on">
    <defs>
      <marker id={id} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M2 1L8 5L2 9" fill="none" stroke="#2d2a2b" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </marker>
    </defs>
    <g fill="none" stroke="#2d2a2b" stroke-width="1.6" stroke-linecap="round">
      <path d="M164 142 Q 230 96 296 142" marker-end={`url(#${id})`}/>
      <path d="M296 198 Q 230 244 164 198" marker-end={`url(#${id})`}/>
      <path d="M384 142 Q 450 96 516 142" marker-end={`url(#${id})`}/>
      <path d="M516 198 Q 450 244 384 198" marker-end={`url(#${id})`}/>
      <path d="M560 222 C 560 330, 120 330, 120 226" marker-end={`url(#${id})`}/>
    </g>
    {states.map((s) => (
      <g>
        <circle cx={s.cx} cy={s.cy} r="52" fill="#ffffff" stroke="#2d2a2b" stroke-width="1.8"/>
        <text x={s.cx} y={s.cy} text-anchor="middle" dominant-baseline="central" style="font-size:15px;font-weight:700;fill:#2d2a2b">{s.label}</text>
      </g>
    ))}
    {labels.map((l) => (
      <text x={l.x} y={l.y} text-anchor="middle" dominant-baseline="central" style="font-size:13.5px;font-weight:600;fill:#4a4a4a">{l.text}</text>
    ))}
  </svg>
</Figure>
