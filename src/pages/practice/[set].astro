---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Quiz from '../../components/Quiz.astro';
import { getPracticeSets } from '../../lib/practice';
import { url } from '../../lib/site';

export async function getStaticPaths() {
  return (await getPracticeSets()).map((set) => ({ params: { set: set.slug }, props: { set } }));
}
const { set } = Astro.props;
---
<BaseLayout title={`Practice: ${set.title}`}>
  <PageHead eyebrow="Practice · questions from Sample Papers A-D" title={set.title}>
    <p class="back no-print"><a href={url('past-papers')}>← Sample papers and practice</a></p>
  </PageHead>
  <div class="container">
    <p class="card card--tint explain">{set.blurb} {set.questions.length} questions, pooled from all four ISTQB sample papers - answer them all,
      then submit to see your score and why each option is right or wrong.</p>
    <Quiz questions={set.questions} quizId={`practice-${set.slug}`} />
  </div>
</BaseLayout>

<style>
  .back { margin: 1rem 0 0; font-weight: 700; }
  .explain { margin: 0 0 1.25rem; }
</style>
