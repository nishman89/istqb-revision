---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import WatchOut from '../../components/WatchOut.astro';
import { chapterHandout, handoutUrl } from '../../data/handouts';
import { getChapters, getQuestions } from '../../lib/data';
import { url, MAIN_SET, PRACTICE_SETS, QUESTIONS_PER_CHAPTER } from '../../lib/site';

export async function getStaticPaths() {
  const chapters = await getChapters();
  return chapters.map((entry, i) => ({
    params: { chapter: String(entry.data.number) },
    props: { entry, prev: chapters[i - 1]?.data, next: chapters[i + 1]?.data },
  }));
}

const { entry, prev, next } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
// Group topics (h3) under their section (h2) for the collapsible contents menu.
type Group = { text: string; slug: string; topics: { text: string; slug: string }[] };
const groups = headings.reduce<Group[]>((acc, h) => {
  if (h.depth === 2) acc.push({ text: h.text, slug: h.slug, topics: [] });
  else if (h.depth === 3) {
    if (!acc.length) acc.push({ text: 'Introduction', slug: h.slug, topics: [] });
    acc[acc.length - 1].topics.push({ text: h.text, slug: h.slug });
  }
  return acc;
}, []);
const practice = await Promise.all(PRACTICE_SETS.map(async (s) => ({ set: s, count: (await getQuestions(s, data.number)).length })));
const mainCount = (await getQuestions(MAIN_SET, data.number)).length;
const practiceCount = (set: string) => (set === MAIN_SET ? mainCount : practice.find((p) => p.set === set)?.count ?? 0);
---
<BaseLayout title={`Chapter ${data.number}: ${data.title}`} description={data.summary}>
  <PageHead eyebrow={`Chapter ${data.number} · ${QUESTIONS_PER_CHAPTER[data.number]} questions in the exam`} title={data.title}>
    <p class="summary">{data.summary}</p>
    <p class="downloads no-print">
      <a class="btn btn--dark" href={handoutUrl(chapterHandout(data.number))} download>
        <span aria-hidden="true">⬇</span> Chapter {data.number} handout (PDF)
      </a>
      <a class="btn btn--ghost" href={url('handouts')}>All handouts &amp; practice workbook</a>
    </p>
  </PageHead>

  <div class="container layout">
    <aside class="toc no-print" aria-label="In this chapter">
      <details class="card toc__panel" open data-toc>
        <summary class="eyebrow">In this chapter</summary>
        <ul class="toc__groups">
          {groups.map((g) => (
            <li>
              <details>
                <summary><span class="chev" aria-hidden="true"></span><span>{g.text}</span></summary>
                <ul>{g.topics.map((t) => <li><a href={`#${t.slug}`}>{t.text}</a></li>)}</ul>
              </details>
            </li>
          ))}
        </ul>
        <a class="btn quiz-btn" href={url(`quiz/${data.number}/${MAIN_SET.toLowerCase()}`)}>Chapter quiz →</a>
      </details>
    </aside>

    <article class="notes">
      <section class="card objectives">
        <h2>You will learn</h2>
        <ul>{data.objectives.map((o) => <li>{o}</li>)}</ul>
      </section>

      <div class="section-controls no-print">
        <button type="button" class="link" data-expand="open">Expand all sections</button>
        <button type="button" class="link" data-expand="close">Collapse all</button>
      </div>
      <div class="prose"><Content /></div>

      <WatchOut chapter={data.number} />

      <section class="card card--dark finish no-print" id="finish">
        <h2>Finished the notes? Test yourself.</h2>
        <p>The <strong>chapter quiz</strong> uses the questions from <strong>ISTQB Sample Paper {MAIN_SET}</strong> that cover
          Chapter {data.number}: {practiceCount(MAIN_SET)} question{practiceCount(MAIN_SET) === 1 ? '' : 's'}, the same number
          the real exam asks on this chapter. Every answer is explained when you submit.</p>
        <div class="finish__actions">
          <button class="btn btn--ghost btn--light" type="button" data-mark-read={data.number}>Mark notes as read</button>
          <a class="btn" href={url(`quiz/${data.number}/${MAIN_SET.toLowerCase()}`)}>Take the chapter quiz</a>
        </div>
        <div class="practice">
          <p>Want more practice? You can also answer the Chapter {data.number} questions from the other ISTQB sample papers:</p>
          <ul>
            {practice.map(({ set, count }) => (
              <li><a href={url(`quiz/${data.number}/${set.toLowerCase()}`)}>Sample Paper {set} <span>{count} questions</span></a></li>
            ))}
          </ul>
        </div>
      </section>

      <nav class="pager no-print" aria-label="Chapters">
        {prev ? <a href={url(`chapters/${prev.number}`)}>← Chapter {prev.number}: {prev.title}</a> : <span></span>}
        {next && <a href={url(`chapters/${next.number}`)}>Chapter {next.number}: {next.title} →</a>}
      </nav>
    </article>
  </div>
</BaseLayout>

<script>
  import { isChapterRead, markChapterRead, saveLastVisit } from '../../lib/progress';

  // ---- Highlight the topic being read in the contents menu, and remember it for "Continue where you left off"
  const chapterNo = Number(document.querySelector<HTMLElement>('[data-mark-read]')?.dataset.markRead);
  const tocLinks = new Map([...document.querySelectorAll<HTMLAnchorElement>('.toc__groups a')].map((a) => [a.hash.slice(1), a]));
  const spy = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      const h = entry.target as HTMLElement;
      tocLinks.forEach((a) => a.removeAttribute('aria-current'));
      const link = tocLinks.get(h.id);
      if (link) {
        link.setAttribute('aria-current', 'true');
        const group = link.closest('details');
        if (group && !group.open) group.open = true;
      }
      saveLastVisit({ chapter: chapterNo, slug: h.id, title: h.textContent ?? '' });
    }
  }, { rootMargin: '0px 0px -70% 0px' });
  document.querySelectorAll('.prose h3[id]').forEach((h) => spy.observe(h));

  // ---- "Next section" button at the end of every section
  const sections = [...document.querySelectorAll<HTMLDetailsElement>('details.chapter-section')];
  sections.forEach((section, i) => {
    const next = sections[i + 1];
    const body = section.querySelector('.chapter-section__body');
    if (!body) return;
    const bar = document.createElement('div');
    bar.className = 'section-end no-print';
    const title = (next?.querySelector('h2')?.textContent ?? '').replace(/[<>&]/g, '');
    bar.innerHTML = next
      ? `<button type="button" class="btn btn--dark">Next: ${title} →</button>`
      : `<a class="btn" href="#finish">Finished - test yourself →</a>`;
    body.append(bar);
    bar.querySelector('button')?.addEventListener('click', () => {
      section.open = false;
      next!.open = true;
      next!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // The contents panel starts open on desktop (sticky sidebar) and closed on phones (it sits above the notes).
  const toc = document.querySelector<HTMLDetailsElement>('[data-toc]');
  const narrow = window.matchMedia('(max-width: 56rem)');
  const syncToc = () => { if (toc) toc.open = !narrow.matches; };
  syncToc();
  narrow.addEventListener('change', syncToc);

  // Open the collapsed section that holds a linked topic, then jump to it.
  function reveal(id: string) {
    const target = document.getElementById(decodeURIComponent(id));
    if (!target) return;
    for (let d = target.closest('details'); d; d = d.parentElement?.closest('details') ?? null) d.open = true;
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
    if (!link) return;
    e.preventDefault();
    const id = link.hash.slice(1);
    history.pushState(null, '', `#${id}`);
    reveal(id);
  });
  if (location.hash) reveal(location.hash.slice(1));
  window.addEventListener('hashchange', () => reveal(location.hash.slice(1)));

  document.querySelectorAll<HTMLButtonElement>('[data-expand]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const open = btn.dataset.expand === 'open';
      document.querySelectorAll<HTMLDetailsElement>('details.chapter-section, details.chapter-topic').forEach((d) => (d.open = open));
    }),
  );

  const button = document.querySelector<HTMLButtonElement>('[data-mark-read]');
  if (button) {
    const chapter = Number(button.dataset.markRead);
    const showDone = () => { button.textContent = '✓ Marked as read'; button.disabled = true; };
    if (isChapterRead(chapter)) showDone();
    button.addEventListener('click', () => { markChapterRead(chapter); showDone(); });
  }
</script>

<style>
  .summary { max-width: 46rem; font-size: 1.1rem; color: var(--grey); margin: 1rem 0 0; }
  .downloads { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0 0; }
  .downloads .btn { padding: 0.55rem 1.1rem; font-size: 0.95rem; }
  .layout { display: grid; grid-template-columns: 17rem 1fr; gap: 2rem; align-items: start; }
  .toc { position: sticky; top: 5.5rem; }
  .toc__panel { max-height: calc(100vh - 7rem); overflow-y: auto; }
  .toc__panel > summary.eyebrow { list-style: none; cursor: default; pointer-events: none; margin-bottom: 0.25rem; }
  .toc__panel > summary::-webkit-details-marker { display: none; }
  .toc__groups { list-style: none; padding: 0; margin: 0.5rem 0 1rem; display: grid; gap: 0.25rem; }
  .toc__groups summary { cursor: pointer; font-weight: 700; font-size: 0.95rem; padding: 0.35rem 0.25rem; border-radius: 6px; list-style: none; display: grid; grid-template-columns: 0.9rem 1fr; gap: 0.35rem; align-items: start; }
  .toc__groups .chev { width: 0; height: 0; margin-top: 0.42em; border-left: 6px solid var(--pink); border-top: 5px solid transparent; border-bottom: 5px solid transparent; transition: transform 0.15s; transform-origin: 30% 50%; }
  .toc__groups details[open] > summary .chev { transform: rotate(90deg); }
  .toc__groups summary::-webkit-details-marker { display: none; }
  .toc__groups summary:hover { background: var(--pink-tint); }
  .toc details ul { list-style: none; margin: 0 0 0.5rem; padding: 0 0 0 1.1rem; border-left: 2px solid var(--pink-tint); display: grid; gap: 0.2rem; font-size: 0.875rem; }
  .toc__groups details a { color: var(--grey); text-decoration: none; display: block; padding: 0.15rem 0.4rem; border-radius: 6px; }
  .toc__groups details a:hover { color: var(--pink-dark); background: var(--bg); }
  .toc__groups details a[aria-current] { color: var(--pink-dark); background: var(--pink-tint); font-weight: 700; }
  .prose :global(.section-end) { display: flex; justify-content: flex-end; margin-top: 1.25rem; padding-top: 1rem; border-top: 1px dashed var(--line); }
  .prose :global(.section-end .btn) { white-space: normal; text-align: left; }
  .quiz-btn { width: 100%; }
  .notes { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; min-width: 0; }
  .objectives { border-left: 8px solid var(--pink); }
  .objectives ul { margin: 0; padding-left: 1.25rem; }

  /* Notes generated from the slides */
  .section-controls { display: flex; gap: 1rem; justify-content: flex-end; font-size: 0.9rem; }
  .link { background: none; border: 0; color: var(--pink-dark); font: inherit; font-weight: 700; text-decoration: underline; cursor: pointer; padding: 0; }
  .prose :global(details.chapter-section) { margin: 0 0 1rem; }
  .prose :global(details.chapter-section > summary) { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 1rem; padding: 0.9rem 1.25rem; background: var(--charcoal); color: #fff; border-radius: 12px; border-left: 8px solid var(--pink); }
  .prose :global(details.chapter-section > summary::-webkit-details-marker) { display: none; }
  .prose :global(details.chapter-section > summary::after) { content: '+'; margin-left: auto; font: 700 1.6rem/1 var(--font-head); color: var(--pink-soft); }
  .prose :global(details.chapter-section[open] > summary::after) { content: '−'; }
  .prose :global(details.chapter-section > summary h2) { margin: 0; font-size: 1.4rem; color: #fff; }
  .prose :global(details.chapter-section > summary:hover) { background: #3a3637; }
  .prose :global(.chapter-section__body) { padding: 0.5rem 0.25rem 1rem; }

  /* Topics inside a section */
  .prose :global(details.chapter-topic) { margin: 0.5rem 0 0.25rem; }
  .prose :global(details.chapter-topic > summary) {
    list-style: none; cursor: pointer; display: flex; align-items: center; gap: 0.75rem;
    padding: 0.4rem 0.6rem; margin: 1.25rem -0.6rem 0.5rem; border-radius: 10px;
  }
  .prose :global(details.chapter-topic > summary::-webkit-details-marker) { display: none; }
  .prose :global(details.chapter-topic > summary:hover) { background: var(--pink-tint); }
  .prose :global(details.chapter-topic > summary h3) { margin: 0; }
  .prose :global(details.chapter-topic > summary::after) {
    content: '−'; margin-left: auto; flex: none; display: grid; place-items: center; width: 1.8rem; height: 1.8rem;
    border-radius: 50%; border: 2px solid var(--line); font: 700 1.1rem/1 var(--font-body); color: var(--pink-dark);
  }
  .prose :global(details.chapter-topic:not([open]) > summary::after) { content: '+'; }
  .prose :global(details.chapter-topic:not([open]) > summary) { background: var(--surface); box-shadow: var(--shadow); margin-bottom: 0.25rem; }
  .prose :global(.chapter-topic__body) { padding-bottom: 0.5rem; }
  .prose :global(h3) { margin: 0; }
  .prose :global(h4) { font: 700 0.8rem var(--font-body); letter-spacing: 0.08em; text-transform: uppercase; color: var(--pink-dark); margin: 1rem 0 0.25rem; }
  .prose :global(ul) { background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); padding: 1rem 1.25rem 1rem 2.25rem; margin: 0.5rem 0; }
  .prose :global(li) { margin: 0.3rem 0; }

  /* Lists reshaped by rehype-tidy-lists.mjs: lead-in paragraphs, tag rows and key-point cards */
  .prose :global(p.lead-in) { margin: 0.5rem 0 0.75rem; font-size: 1.05rem; }
  .prose :global(ul.tags) {
    list-style: none; background: none; box-shadow: none; padding: 0; margin: 0.5rem 0 1rem;
    display: flex; flex-wrap: wrap; gap: 0.5rem;
  }
  .prose :global(ul.tags li) {
    margin: 0; padding: 0.4rem 0.9rem; border-radius: 999px; background: var(--surface);
    border: 2px solid var(--pink-tint); font-weight: 600; font-size: 0.95rem; box-shadow: var(--shadow);
  }
  .prose :global(ul.tags li)::marker { content: none; }

  /* Key-point lists rendered as cards */
  .prose :global(ul.cards) {
    list-style: none; background: none; box-shadow: none; padding: 0; margin: 0.75rem 0;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem;
  }
  .prose :global(ul.cards > .card-item) { flex: 0 1 calc((100% - (var(--cols, 3) - 1) * 0.75rem) / var(--cols, 3)); }

  /* Pros / cons side by side */
  .prose :global(ul.versus > .card-item:first-child) { border-top-color: var(--success); background: var(--success-tint); }
  .prose :global(ul.versus > .card-item:last-child) { border-top-color: var(--pink); background: var(--pink-tint); }
  .prose :global(ul.versus .card-item__title) { font-size: 1.15rem; }

  /* Long lists: a compact two-column definition list */
  .prose :global(ul.deflist) { list-style: none; padding: 0.5rem 1.25rem; display: grid; gap: 0; }
  .prose :global(ul.deflist > .card-item) {
    display: grid; grid-template-columns: minmax(9rem, 14rem) 1fr; gap: 1rem; margin: 0; padding: 0.65rem 0;
    background: none; box-shadow: none; border: 0; border-bottom: 1px solid var(--line); border-radius: 0;
  }
  .prose :global(ul.deflist > .card-item:last-child) { border-bottom: 0; }
  .prose :global(ul.deflist .card-item__title) { color: var(--pink-dark); }
  .prose :global(.card-item) {
    margin: 0; display: flex; flex-direction: column; gap: 0.35rem;
    background: var(--surface); border-radius: 12px; box-shadow: var(--shadow);
    padding: 0.9rem 1rem 1rem; border-top: 4px solid var(--pink);
  }
  .prose :global(.card-item:nth-child(even)) { border-top-color: var(--charcoal); }
  .prose :global(.card-item__title) { font: 700 1.05rem/1.3 var(--font-head); color: var(--charcoal); }
  .prose :global(.card-item__body) { font-size: 0.95rem; color: var(--grey); line-height: 1.5; }
  .prose :global(li)::marker { color: var(--pink); }
  .prose :global(table) { background: var(--surface); display: block; overflow-x: auto; }

  .finish p { color: #ddd; }
  .finish__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1rem 0; }
  .btn--light { color: #fff; border-color: #fff; }
  .btn--light:hover { background: #fff; color: var(--charcoal); }
  .practice { border-top: 1px solid #555; padding-top: 1rem; }
  .practice p { margin: 0 0 0.5rem; }
  .practice ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .practice a { display: inline-flex; gap: 0.5rem; align-items: center; padding: 0.45rem 0.9rem; border: 2px solid #666; border-radius: 999px; color: #fff; font-weight: 700; text-decoration: none; }
  .practice a:hover { border-color: var(--pink); background: var(--pink); }
  .practice a span { font-weight: 600; color: var(--pink-soft); font-size: 0.85rem; }
  .practice a:hover span { color: #fff; }
  .pager { display: flex; justify-content: space-between; gap: 1rem; font-weight: 700; }
  @media (max-width: 56rem) {
    .layout { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
    .toc { position: static; }
    .toc__panel { max-height: none; }
    .toc__panel > summary.eyebrow { pointer-events: auto; cursor: pointer; display: flex; justify-content: space-between; font-size: 0.9rem; }
    .toc__panel > summary.eyebrow::after { content: '+'; font: 700 1.3rem/1 var(--font-head); }
    .toc__panel[open] > summary.eyebrow::after { content: '−'; }
    .section-controls { justify-content: flex-start; }
    .prose :global(details.chapter-section > summary) { padding: 0.75rem 1rem; }
    .prose :global(details.chapter-section > summary h2) { font-size: 1.15rem; }
    .prose :global(.table-wrap), .prose :global(table) { display: block; overflow-x: auto; }
    .pager { flex-direction: column; }
    .prose :global(ul.cards > .card-item) { flex-basis: 100%; }
    .prose :global(ul.deflist > .card-item) { grid-template-columns: 1fr; gap: 0.15rem; }
  }
</style>
