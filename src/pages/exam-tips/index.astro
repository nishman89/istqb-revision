---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { url } from '../../lib/site';
import { K3_TOPICS } from '../../lib/k3';

// Everything below is calculated from the four ISTQB sample papers at build time.
const exams = await getCollection('exams');
const qs = exams.flatMap((e) => e.data.questions);
const total = qs.length;
const pct = (n: number) => Math.round((n / total) * 100);
const stemText = (q: (typeof qs)[number]) => q.blocks.map((b) => ('text' in b ? b.text : '')).join(' ');

const kCount = (k: string) => qs.filter((q) => q.k === k).length;
const perPaper = (k: string) => Math.round(kCount(k) / exams.length);
const byChapter = (ch: number, k?: string) => {
  const n = qs.filter((q) => q.chapter === ch && (!k || q.k === k)).length / exams.length;
  return n ? Math.round(n * 10) / 10 : '-';
};
const CHAPTERS = (await getCollection('chapters')).sort((a, b) => a.data.number - b.data.number).map((c) => ({ n: c.data.number, title: c.data.title }));
const LEVELS = [
  { k: 'K1', name: 'Remember', time: '1 minute', what: 'Recall a term, fact or definition - e.g. which option is a typical test objective.',
    how: 'You either know it or you don\'t - answer quickly and move on. Learn the key terms in each chapter.' },
  { k: 'K2', name: 'Understand', time: '1-2 minutes', what: 'Explain, compare, classify or give an example - most of the exam.',
    how: 'Read every option before choosing; several may sound right, so pick the one that best fits the exact wording.' },
  { k: 'K3', name: 'Apply', time: '3 minutes', what: 'Use a technique on a scenario - partitions, boundaries, decision tables, estimates…',
    how: 'Work it out on scratch paper first, then find your answer among the options. Never guess from the options alone.' },
];
const keywords = ['BEST', 'MOST', 'NOT', 'CORRECT', 'LEAST'].map((w) => ({
  word: w,
  n: qs.filter((q) => new RegExp(`\\b${w}\\b`).test(stemText(q))).length,
}));
const withKeyword = qs.filter((q) => keywords.some(({ word }) => new RegExp(`\\b${word}\\b`).test(stemText(q)))).length;
---
<BaseLayout title="Exam tips" description="Exam technique for ISTQB CTFL v4.0, based on an analysis of the four official sample papers.">
  <PageHead eyebrow="Exam technique" title="Exam tips">
    <p class="lead">What {total} questions from ISTQB Sample Papers A-D tell us about the real exam - and how to pick up the marks that are easiest to gain.</p>
  </PageHead>

  <div class="container tips">
    <nav class="on-page no-print" aria-label="On this page">
      <span class="eyebrow">On this page</span>
      <ul>
        <li><a href="#k-levels">The K-levels</a></li>
        <li><a href="#k3">8 calculation skills</a></li>
        <li><a href="#key-words">Key words</a></li>
        <li><a href="#formats">Question formats</a></li>
        <li><a href="#on-the-day">On the day</a></li>
      </ul>
    </nav>
    <section>
      <h2 class="dot" id="k-levels">1. Know the three K-levels</h2>
      <p>Every question tests one learning objective at one <strong>knowledge level (K-level)</strong>. Each one needs a different approach -
        and you can practise each on its own, using every question from Sample Papers A-D.</p>
      <div class="grid klevels">
        {LEVELS.map((l) => (
          <article class="card klevel">
            <span class="klevel__k">{l.k}</span>
            <h3>{l.name}</h3>
            <p class="klevel__share"><strong>{perPaper(l.k)}</strong> of 40 questions per paper · {pct(kCount(l.k))}%</p>
            <p>{l.what}</p>
            <p class="klevel__how"><strong>How to answer:</strong> {l.how}</p>
            <p class="klevel__time">Allow about {l.time} per question</p>
            <a class="btn" href={url(`practice/${l.k.toLowerCase()}`)}>Practise {kCount(l.k)} {l.k} questions</a>
          </article>
        ))}
      </div>

      <h3 class="sub">Where the K1 and K2 questions come from</h3>
      <p class="muted">Average number of questions per paper, by chapter (Sample Papers A-D).</p>
      <div class="table-wrap">
        <table class="breakdown">
          <thead><tr><th>Chapter</th><th>K1</th><th>K2</th><th>K3</th><th>Total</th></tr></thead>
          <tbody>
            {CHAPTERS.map((c) => (
              <tr>
                <td><a href={url(`chapters/${c.n}`)}>{c.n}. {c.title}</a></td>
                <td>{byChapter(c.n, 'K1')}</td><td>{byChapter(c.n, 'K2')}</td><td>{byChapter(c.n, 'K3')}</td>
                <td><strong>{byChapter(c.n)}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2 class="dot" id="k3">2. Master the 8 calculation skills (K3)</h2>
      <div class="card card--dark highlight">
        <p class="big">{kCount('K3')} of {total}</p>
        <p>K3 questions in the sample papers all come from the <strong>same 8 learning objectives</strong> -
          and every paper has <strong>exactly one</strong> question on each. Master these 8 skills and you have 8 of the 40 marks.</p>
        <a class="btn" href={url('practice/k3')}>Practise all {kCount('K3')} K3 questions</a>
      </div>
      <div class="grid k3">
        {K3_TOPICS.map((t, i) => (
          <article class="card k3__card">
            <span class="k3__num">{i + 1}</span>
            <span class="pill">{t.lo}</span>
            <h3>{t.title}</h3>
            <ol>{t.method.map((m) => <li>{m}</li>)}</ol>
            <a href={url(t.notes)}>Revise in the notes →</a>
          </article>
        ))}
      </div>
    </section>

    <section>
      <h2 class="dot" id="key-words">3. Read the key word twice</h2>
      <p>{pct(withKeyword)}% of questions turn on a qualifier. Underline it in your head before you look at the options.</p>
      <ul class="words">
        {keywords.map(({ word, n }) => <li><span class="word">{word}</span><span class="muted">{n} questions</span></li>)}
      </ul>
      <div class="table-wrap">
        <table class="kw">
          <thead><tr><th>Key word</th><th>What it means</th><th>How to answer</th></tr></thead>
          <tbody>
            <tr><td><strong>BEST</strong> / <strong>MOST</strong></td><td>Several options may be partly true - one is the strongest fit.</td><td>Don't stop at the first true-sounding option. Compare them all against the exact situation in the question.</td></tr>
            <tr><td><strong>CORRECT</strong> / <strong>TRUE</strong></td><td>Exactly one option is fully true; the others contain an error.</td><td>Look for the small detail that makes each wrong option false - a swapped term, a wrong order, a reversed cause and effect.</td></tr>
            <tr><td><strong>NOT</strong> / <strong>LEAST</strong></td><td>The question is flipped: three options are true or likely.</td><td>You're hunting for the odd one out. Tick off the three that fit, and what's left is the answer.</td></tr>
          </tbody>
        </table>
      </div>
      <p><strong>Also watch the wording inside the options.</strong> Words like <em>always</em>, <em>never</em>, <em>only</em>, <em>all</em> and <em>guarantees</em>
        make a statement absolute - it must be true in every case, so check whether the syllabus really says that
        (for example, testing can never <em>guarantee</em> there are no defects). Words like <em>typically</em>, <em>may</em> and <em>can</em> are softer and
        easier to be true. Neither is a reliable clue on its own - read what the statement actually claims.</p>
      <p class="caveat">These counts come from the 160 questions in ISTQB Sample Papers A-D. The real exam is written to the same
        rules, but its exact mix of key words will vary.</p>
    </section>


    <section>
      <h2 class="dot" id="formats">4. Know the question formats</h2>
      <p>Every paper mixes in a few question formats that need a different approach:</p>
      <div class="grid formats">
        <div class="card"><h3>Matching</h3><p>Pair 1-4 with A-D. Find the pairings you're sure of, then rule out options that contradict them.</p></div>
        <div class="card"><h3>Select TWO</h3><p>Out of five options. You need both right to score the point.</p></div>
        <div class="card"><h3>i, ii, iii combinations</h3><p>Decide each statement true or false first, then find the option that matches.</p></div>
        <div class="card"><h3>Tables, logs and diagrams</h3><p>Decision tables, state models, traceability matrices, test logs. Work through them on the scratch paper.</p></div>
      </div>
    </section>

    <section class="card card--tint">
      <h2 id="on-the-day">5. On the day</h2>
      <ul class="day">
        <li><strong>60 minutes for 40 questions</strong> (75 if the exam isn't in your native language) - about 1½ minutes each.</li>
        <li><strong>Do a first pass</strong> answering everything you're sure of; flag the slow calculations and come back to them.</li>
        <li><strong>Allow ~1 minute for K1, 1-2 for K2 and 3 for K3</strong> - the 8 calculation questions deserve the extra time.</li>
        <li><strong>26 / 40 (65%) passes.</strong> You can drop 14 marks and still pass - don't panic over one hard question.</li>
      </ul>
      <p class="muted">Statistics calculated from ISTQB® CTFL v4.0 Sample Papers A (v1.7), B (v1.7), C (v1.6) and D (v1.5). Timing guidance from ISTQB® Exam Structures and Rules v1.2.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .on-page { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; }
  .on-page ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .on-page a { display: block; padding: 0.35rem 0.85rem; border-radius: 999px; background: var(--surface); box-shadow: var(--shadow); font-weight: 700; text-decoration: none; color: var(--charcoal); font-size: 0.9rem; }
  .on-page a:hover { background: var(--pink-tint); color: var(--pink-dark); }
  .lead { max-width: 46rem; font-size: 1.1rem; color: var(--grey); margin: 1rem 0 0; }
  .tips { display: grid; gap: 3rem; }
  .tips h2 { margin-bottom: 1rem; }
  .klevel { display: flex; flex-direction: column; gap: 0.35rem; border-top: 5px solid var(--pink); }
  .klevel:nth-child(2) { border-top-color: var(--charcoal); }
  .klevel h3 { margin: 0; }
  .klevel p { margin: 0; }
  .klevel__k { font: 700 2.2rem/1 var(--font-head); color: var(--pink-dark); }
  .klevel__share { color: var(--grey); }
  .klevel__how { background: var(--bg); border-radius: 10px; padding: 0.6rem 0.75rem; font-size: 0.95rem; }
  .klevel__time { font-size: 0.9rem; font-weight: 700; color: var(--pink-dark); }
  .klevel .btn { margin-top: auto; align-self: flex-start; }
  .klevels { margin-bottom: 2rem; }
  .sub { margin: 1.5rem 0 0.25rem; }
  .breakdown td:not(:first-child), .breakdown th:not(:first-child) { text-align: center; }
  .highlight { display: grid; gap: 0.5rem; border-left: 8px solid var(--pink); margin-bottom: 1.25rem; }
  .highlight p { margin: 0; color: #ddd; max-width: 50rem; }
  .highlight .btn { justify-self: start; margin-top: 0.5rem; }
  .big { font: 700 2.75rem/1 var(--font-head) !important; color: var(--pink-soft) !important; }
  .k3 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 15.5rem), 1fr)); }
  .k3__card { position: relative; display: flex; flex-direction: column; gap: 0.4rem; border-top: 5px solid var(--pink); }
  .k3__card:nth-child(even) { border-top-color: var(--charcoal); }
  .k3__num { position: absolute; right: 1rem; top: 0.5rem; font: 700 2.5rem var(--font-head); color: var(--pink-tint); }
  .k3__card .pill { align-self: flex-start; }
  .k3__card h3 { margin: 0.25rem 0 0; }
  .k3__card ol { padding-left: 1.2rem; margin: 0.25rem 0 0.5rem; font-size: 0.95rem; display: grid; gap: 0.35rem; }
  .k3__card a { margin-top: auto; font-weight: 700; }
  .words { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .words li { flex: 1 1 9rem; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; background: var(--surface); box-shadow: var(--shadow); border-radius: 12px; padding: 0.9rem 1rem; }
  .word { font: 700 1.4rem var(--font-head); color: var(--pink-dark); }
  .formats { grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .formats .card { border-top: 5px solid var(--pink); }
  .formats .card:nth-child(even) { border-top-color: var(--charcoal); }
  .formats h3 { margin: 0 0 0.25rem; }
  .kw td:first-child { white-space: nowrap; color: var(--pink-dark); }
  .caveat { font-size: 0.9rem; color: var(--grey); border-left: 4px solid var(--line); padding-left: 0.75rem; margin-top: 0.5rem; }
  .day { display: grid; gap: 0.5rem; padding-left: 1.25rem; }
  .day li::marker { color: var(--pink); }
</style>
