---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHead from '../../../components/PageHead.astro';
import Quiz from '../../../components/Quiz.astro';
import { getChapters, getQuestions } from '../../../lib/data';
import { url, MAIN_SET } from '../../../lib/site';
import { quizId } from '../../../lib/progress';

export async function getStaticPaths() {
  const chapters = await getChapters();
  // The chapter quiz uses the main paper only; wider practice lives in /practice/chapter-N/.
  return chapters.map(({ data }) => ({ params: { chapter: String(data.number), set: MAIN_SET.toLowerCase() }, props: { chapter: data, set: MAIN_SET } }));
}

const { chapter, set } = Astro.props;
const questions = await getQuestions(set, chapter.number);
---
<BaseLayout title={`Chapter ${chapter.number} quiz`}>
  <PageHead eyebrow={`Chapter ${chapter.number} · Chapter quiz · ISTQB Sample Paper ${set}`} title={chapter.title}>
    <p class="back no-print"><a href={url(`chapters/${chapter.number}`)}>← Back to the Chapter {chapter.number} notes</a></p>
  </PageHead>

  <div class="container">
    <p class="explain card card--tint">This is the <strong>Chapter {chapter.number} quiz</strong>: the {questions.length} questions from
      <strong>ISTQB Sample Paper {set}</strong> that cover this chapter - the same number the real exam asks on it.</p>
    <Quiz questions={questions} quizId={quizId(chapter.number, set)} />

    <nav class="more card no-print" aria-label="More practice">
      <span class="eyebrow">Want more practice?</span>
      <p><a class="btn btn--dark" href={url(`practice/chapter-${chapter.number}`)}>Practise all Chapter {chapter.number} questions from Sample Papers A-D</a></p>
    </nav>
  </div>
</BaseLayout>

<style>
  .back { margin: 1rem 0 0; font-weight: 700; }
  .explain { margin: 0 0 1.25rem; }
  .more { margin-top: 2rem; }
  .more p { margin: 0.5rem 0 0; }
</style>
