---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getChapters } from '../lib/data';
import { url, formatMinutes, QUESTIONS_PER_CHAPTER, MAIN_SET } from '../lib/site';
import { quizId } from '../lib/progress';

const chapters = await getChapters();
---
<BaseLayout title="Home">
  <section class="hero">
    <div class="container hero__inner">
      <span class="eyebrow">ISTQB® CTFL v4.0</span>
      <h1 class="dot">Certified Tester Foundation Level</h1>
      <p>Chapter notes taken from the Sparta Global course slides, each mapped to its section of the syllabus, plus
        end-of-chapter practice using the official ISTQB sample exams - with an explanation for every answer.</p>
      <div class="hero__actions">
        <a class="btn" href={url('introduction')}>Start with the introduction</a>
        <a class="btn btn--ghost btn--light" href={url('chapters/1')}>Go to Chapter 1</a>
        <a class="btn btn--ghost btn--light" href={url('past-papers')}>Sit a past paper</a>
        <a class="btn btn--ghost btn--light" href={url('handouts')}>Download handouts</a>
      </div>
    </div>
  </section>

  <div class="container">
    <a class="card continue no-print" data-continue data-base={url()} hidden href="#">
      <span class="eyebrow">Continue where you left off</span>
      <span class="continue__title" data-continue-title></span>
      <span class="continue__arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <section class="container chapters">
    <h2 class="dot">Chapters</h2>
    <ol class="grid">
      {chapters.map(({ data }) => (
        <li class="card chapter" data-chapter={data.number} data-quiz={quizId(data.number, MAIN_SET)}>
          <span class="chapter__num">{data.number}</span>
          <h3><a href={url(`chapters/${data.number}`)}>{data.title}</a></h3>
          <p class="muted">{data.summary}</p>
          <p class="chapter__meta">
            <span class="pill">{QUESTIONS_PER_CHAPTER[data.number]} exam questions</span>
            <span class="pill pill--dark">{formatMinutes(data.minutes)} course time</span>
          </p>
          <p class="chapter__status" data-status></p>
          <div class="chapter__actions">
            <a class="btn btn--dark" href={url(`chapters/${data.number}`)}>Read notes</a>
            <a class="btn btn--ghost" href={url(`quiz/${data.number}/${MAIN_SET.toLowerCase()}`)}>Take quiz</a>
          </div>
        </li>
      ))}
    </ol>
    <section class="card card--dark papers-cta">
      <div>
        <span class="eyebrow">Ready for the real thing?</span>
        <h2>Past papers</h2>
        <p>Sit any of the four official ISTQB sample exams in full - 40 questions against the clock, with a score for every chapter.
          Read the <a href={url('exam-tips')}>exam tips</a> first.</p>
      </div>
      <a class="btn" href={url('past-papers')}>Go to past papers</a>
    </section>

    <p class="reset no-print">
      Your progress is saved in this browser only.
      <button type="button" class="link" data-reset>Reset my progress</button>
    </p>
  </section>
</BaseLayout>

<script>
  import { loadProgress, resetProgress } from '../lib/progress';

  const progress = loadProgress();
  for (const card of document.querySelectorAll<HTMLElement>('[data-chapter]')) {
    const read = progress.chaptersRead.includes(Number(card.dataset.chapter));
    const quiz = progress.quizzes[card.dataset.quiz!];
    const parts = [read ? '✓ Notes read' : 'Notes not read yet'];
    parts.push(quiz ? `Quiz best ${quiz.best.percent}% ${quiz.best.passed ? '✓ passed' : ''}` : 'Quiz not taken');
    card.querySelector('[data-status]')!.textContent = parts.join(' · ');
    card.classList.toggle('is-done', read && !!quiz?.best.passed);
  }
  const cont = document.querySelector<HTMLAnchorElement>('[data-continue]');
  if (cont && progress.lastVisit) {
    const { chapter, slug, title } = progress.lastVisit;
    cont.href = `${cont.dataset.base}chapters/${chapter}/#${slug}`;
    cont.querySelector('[data-continue-title]')!.textContent = `Chapter ${chapter} · ${title}`;
    cont.hidden = false;
  }
  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    if (confirm('Clear all saved progress and quiz scores on this device?')) {
      resetProgress();
      location.reload();
    }
  });
</script>

<style>
  .hero { background: var(--charcoal); color: #fff; padding: 3.5rem 0; border-bottom: 6px solid var(--pink); }
  .hero__inner p { max-width: 46rem; font-size: 1.15rem; color: #ddd; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .btn--light { color: #fff; border-color: #fff; }
  .btn--light:hover { background: #fff; color: var(--charcoal); }
  .continue { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.2rem 1rem; margin-top: -1.5rem; position: relative; z-index: 1; text-decoration: none; color: var(--charcoal); border-left: 8px solid var(--pink); }
  .continue:hover { background: var(--pink-tint); }
  .continue .eyebrow { grid-column: 1; }
  .continue__title { grid-column: 1; font: 700 1.2rem var(--font-head); }
  .continue__arrow { grid-column: 2; grid-row: 1 / span 2; font-size: 1.6rem; color: var(--pink); }
  .chapters { margin-top: 3rem; }
  .chapters ol { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  .chapter { position: relative; display: flex; flex-direction: column; gap: 0.25rem; border-top: 6px solid var(--charcoal); }
  .chapter.is-done { border-top-color: var(--success); }
  .chapter__num { position: absolute; top: 1rem; right: 1.25rem; font: 700 2.5rem var(--font-head); color: var(--pink-tint); }
  .chapter h3 { padding-right: 2.5rem; }
  .chapter h3 a { color: inherit; text-decoration: none; }
  .chapter h3 a:hover { color: var(--pink-dark); }
  .chapter__meta { display: flex; gap: 0.4rem; flex-wrap: wrap; margin: 0.25rem 0; }
  .chapter__status { font-size: 0.9rem; font-weight: 600; color: var(--grey); min-height: 1.4em; }
  .chapter__actions { display: flex; gap: 0.5rem; margin-top: auto; padding-top: 0.75rem; flex-wrap: wrap; }
  .chapter__actions .btn { padding: 0.5rem 1rem; font-size: 0.95rem; }
  .papers-cta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; margin-top: 2.5rem; border-left: 8px solid var(--pink); }
  .papers-cta h2 { margin: 0.25rem 0; }
  .papers-cta p { margin: 0; color: #ddd; max-width: 40rem; }
  .papers-cta p a { color: var(--pink-soft); font-weight: 700; }
  .reset { margin-top: 2rem; color: var(--grey); font-size: 0.9rem; }
  .link { background: none; border: 0; color: var(--pink-dark); font: inherit; font-weight: 700; text-decoration: underline; cursor: pointer; }
</style>
