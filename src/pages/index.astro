---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getChapters } from '../lib/data';
import { url, formatMinutes, QUESTIONS_PER_CHAPTER, MAIN_SET } from '../lib/site';
import { quizId } from '../lib/progress';

const chapters = await getChapters();
---
<BaseLayout title="Home">
  <section class="hero">
    <div class="container hero__inner">
      <span class="hero__badge">ISTQB® CTFL v4.0</span>
      <h1 class="hero__title">ISTQB Revision Guide<span class="hero__dot">.</span></h1>
      <p class="hero__sub">for the ISTQB® Certified Tester Foundation Level (CTFL) v4.0</p>
      <div class="hero__actions">
        <a class="btn" href={url('introduction')}>Start with the introduction</a>
        <a class="btn btn--ghost btn--light" href={url('past-papers')}>Sit a sample paper</a>
        <a class="btn btn--ghost btn--light" href={url('handouts')}>Download handouts</a>
      </div>
    </div>
  </section>

  <div class="container">
    <a class="card continue no-print" id="continue-reading" data-testid="continue-reading" data-continue data-base={url()} hidden href="#">
      <span class="eyebrow">Continue where you left off</span>
      <span class="continue__title" data-continue-title></span>
      <span class="continue__arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <section class="container chapters">
    <h2 class="dot">Chapters</h2>
    <div class="overall" id="overall-progress" data-testid="overall-progress" data-overall>
      <p class="overall__label"><strong data-overall-count>0</strong> of <span data-overall-total>22</span> sections done</p>
      <div class="bar" aria-hidden="true"><span data-overall-bar></span></div>
    </div>
    <ol class="grid">
      {chapters.map(({ data, body }) => (
        <li class="card chapter" id={`chapter-card-${data.number}`} data-testid={`chapter-card-${data.number}`} data-chapter={data.number} data-sections={(body ?? '').match(/^## /gm)?.length ?? 0} data-quiz={quizId(data.number, MAIN_SET)}>
          <span class="chapter__num">{data.number}</span>
          <h3><a href={url(`chapters/${data.number}`)}>{data.title}</a></h3>
          <p class="muted">{data.summary}</p>
          <p class="chapter__meta">
            <span class="pill">{QUESTIONS_PER_CHAPTER[data.number]} exam questions</span>
            <span class="pill pill--dark">{formatMinutes(data.minutes)} course time</span>
          </p>
          <p class="chapter__status" data-testid={`chapter-status-${data.number}`} data-status></p>
          <div class="chapter__actions">
            <a class="btn btn--dark" href={url(`chapters/${data.number}`)} data-testid={`read-notes-${data.number}`}>Read notes</a>
            <a class="btn btn--ghost" href={url(`quiz/${data.number}/${MAIN_SET.toLowerCase()}`)} data-testid={`take-quiz-${data.number}`}>Take quiz</a>
          </div>
        </li>
      ))}
    </ol>
    <section class="card card--dark papers-cta">
      <div>
        <span class="eyebrow">Ready for the real thing?</span>
        <h2>Sample papers</h2>
        <p>Sit any of the four official ISTQB sample papers in full — 40 questions against the clock, with a score for every chapter.
          Read the <a href={url('exam-tips')}>exam tips</a> first.</p>
      </div>
      <a class="btn" href={url('past-papers')}>Go to sample papers</a>
    </section>

    <p class="reset no-print">
      Your progress is saved in this browser only.
      <button type="button" class="link" id="reset-progress" data-testid="reset-progress" data-reset>Reset my progress</button>
    </p>
  </section>
</BaseLayout>

<script>
  import { loadProgress, resetProgress } from '../lib/progress';

  const progress = loadProgress();
  let overallDone = 0, overallTotal = 0;
  for (const card of document.querySelectorAll<HTMLElement>('[data-chapter]')) {
    const read = progress.chaptersRead.includes(Number(card.dataset.chapter));
    const quiz = progress.quizzes[card.dataset.quiz!];
    const chip = (done: boolean, label: string) => `<span class="chip${done ? ' chip--done' : ''}">${done ? '✓' : '○'} ${label}</span>`;
    const total = Number(card.dataset.sections);
    // a chapter marked as read before section ticking existed counts as all sections done
    const doneCount = read ? total : Math.min(progress.sectionsDone?.[card.dataset.chapter!]?.length ?? 0, total);
    overallDone += doneCount; overallTotal += total;
    card.querySelector('[data-status]')!.innerHTML =
      chip(read, read ? 'Notes read' : `${doneCount} of ${total} sections done`) +
      chip(!!quiz, quiz ? 'Chapter quiz taken' : 'Chapter quiz not taken');
    card.classList.toggle('is-done', read && !!quiz?.best.passed);
  }
  const cont = document.querySelector<HTMLAnchorElement>('[data-continue]');
  if (cont && progress.lastVisit) {
    const { chapter, slug, title } = progress.lastVisit;
    cont.href = `${cont.dataset.base}chapters/${chapter}/#${slug}`;
    cont.querySelector('[data-continue-title]')!.textContent = `Chapter ${chapter} · ${title}`;
    cont.hidden = false;
  }
  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    if (confirm('Clear all saved progress and quiz scores on this device?')) {
      resetProgress();
      location.reload();
    }
  });
  const overall = document.querySelector<HTMLElement>('[data-overall]');
  if (overall) {
    overall.querySelector('[data-overall-count]')!.textContent = String(overallDone);
    overall.querySelector('[data-overall-total]')!.textContent = String(overallTotal);
    overall.querySelector<HTMLElement>('[data-overall-bar]')!.style.width = `${overallTotal ? (overallDone / overallTotal) * 100 : 0}%`;
    overall.classList.toggle('is-complete', overallDone === overallTotal);
  }
</script>

<style>
  .hero { background: var(--charcoal); color: #fff; padding: 3.5rem 0; border-bottom: 6px solid var(--pink); }
  .hero__badge { display: inline-block; padding: 0.3rem 0.9rem; border: 2px solid var(--pink-soft); border-radius: 999px; color: var(--pink-soft); font-weight: 700; font-size: 0.85rem; letter-spacing: 0.08em; }
  .hero__title { font-size: clamp(2.5rem, 7vw, 4.5rem); line-height: 1.05; margin: 1rem 0 0.5rem; }
  .hero__dot { color: var(--pink); }
  .hero__sub { font-size: clamp(1.1rem, 2.4vw, 1.4rem); color: #ddd; margin: 0; max-width: 52rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .btn--light { color: #fff; border-color: #fff; }
  .btn--light:hover { background: #fff; color: var(--charcoal); }
  .continue { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.2rem 1rem; margin-top: -1.5rem; position: relative; z-index: 1; text-decoration: none; color: var(--charcoal); border-left: 8px solid var(--pink); }
  .continue:hover { background: var(--pink-tint); }
  .continue .eyebrow { grid-column: 1; }
  .continue__title { grid-column: 1; font: 700 1.2rem var(--font-head); }
  .continue__arrow { grid-column: 2; grid-row: 1 / span 2; font-size: 1.6rem; color: var(--pink); }
  .chapters { margin-top: 3rem; }
  .chapters ol { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  .chapter { position: relative; display: flex; flex-direction: column; gap: 0.25rem; border-top: 6px solid var(--charcoal); }
  .chapter.is-done { border-top-color: var(--success); }
  .chapter__num { position: absolute; top: 1rem; right: 1.25rem; font: 700 2.5rem var(--font-head); color: var(--pink-tint); }
  .chapter h3 { padding-right: 2.5rem; }
  .chapter h3 a { color: inherit; text-decoration: none; }
  .chapter h3 a:hover { color: var(--pink-dark); }
  .chapter__meta { display: flex; gap: 0.4rem; flex-wrap: wrap; margin: 0.25rem 0; }
  @media (max-width: 40rem) {
    .chapter { padding: 1rem 1.1rem; }
    .chapter > .muted, .chapter__meta { display: none; }
    .chapter h3 { font-size: 1.1rem; margin: 0; }
    .chapter__num { font-size: 1.8rem; top: 0.6rem; }
    .chapter__actions { padding-top: 0.5rem; }
  }
  .chapter__status :global(.chip) { display: inline-block; margin: 0 0.35rem 0.35rem 0; padding: 0.15rem 0.6rem; border-radius: 999px; background: var(--bg); color: var(--grey); font-size: 0.8rem; font-weight: 700; }
  .chapter__status :global(.chip--done) { background: var(--success-tint); color: var(--success); }
  .chapter__status { font-size: 0.9rem; font-weight: 600; color: var(--grey); min-height: 1.4em; }
  .chapter__actions { display: flex; gap: 0.5rem; margin-top: auto; padding-top: 0.75rem; flex-wrap: wrap; }
  .chapter__actions .btn { padding: 0.5rem 1rem; font-size: 0.95rem; }
  .overall { margin: 0 0 1.25rem; max-width: 36rem; }
  .overall__label { margin: 0 0 0.35rem; color: var(--grey); }
  .overall__label strong { color: var(--charcoal); }
  .overall .bar { height: 0.6rem; border-radius: 999px; background: var(--line); overflow: hidden; }
  .overall .bar span { display: block; height: 100%; width: 0; background: var(--pink); border-radius: 999px; transition: width 0.3s ease; }
  .overall.is-complete .bar span { background: var(--success); }
  .papers-cta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; margin-top: 2.5rem; border-left: 8px solid var(--pink); }
  .papers-cta h2 { margin: 0.25rem 0; }
  .papers-cta p { margin: 0; color: #ddd; max-width: 40rem; }
  .papers-cta p a { color: var(--pink-soft); font-weight: 700; }
  .reset { margin-top: 2rem; color: var(--grey); font-size: 0.9rem; }
  .link { background: none; border: 0; color: var(--pink-dark); font: inherit; font-weight: 700; text-decoration: underline; cursor: pointer; }
</style>
