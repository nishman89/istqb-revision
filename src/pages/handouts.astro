---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { HANDOUTS, handoutUrl } from '../data/handouts';
import { url } from '../lib/site';
---
<BaseLayout title="Handouts" description="Download the Sparta Global CTFL chapter handouts and practice workbook as PDFs.">
  <PageHead eyebrow="Downloads" title="Handouts">
    <p class="lead">One summary sheet per chapter, plus a practice workbook with worked examples and exercises.
      Each chapter page also has a download button for its handout.</p>
  </PageHead>

  <div class="container">
    <ul class="grid list">
      {HANDOUTS.map((h) => (
        <li class:list={['card', 'handout', { 'handout--workbook': h.chapter === null }]}>
          <span class="handout__num" aria-hidden="true">{h.chapter ?? '✎'}</span>
          <span class="eyebrow">{h.chapter ? `Chapter ${h.chapter}` : 'All chapters'} · PDF · {h.pages} page{h.pages > 1 ? 's' : ''}</span>
          <h2>{h.title}</h2>
          {!h.chapter && <p class="muted">Worked examples, exercises and answers for the calculation topics.</p>}
          <div class="actions">
            <a class="btn" href={handoutUrl(h)} download data-testid={`download-${h.chapter ? `chapter-${h.chapter}` : "workbook"}`}>Download PDF</a>
            <a class="btn btn--ghost" href={handoutUrl(h)} target="_blank" rel="noopener">Open</a>
            {h.chapter && <a class="notes" href={url(`chapters/${h.chapter}`)}>Notes →</a>}
          </div>
        </li>
      ))}
    </ul>
    <p class="muted small">Handouts © Sparta Global, for internal use only. Content based on the ISTQB® Foundation Level syllabus © ISTQB®.</p>
  </div>
</BaseLayout>

<style>
  .lead { max-width: 48rem; font-size: 1.1rem; color: var(--grey); margin: 1rem 0 0; }
  .list { list-style: none; padding: 0; margin: 0 0 1.5rem; }
  .handout { position: relative; display: flex; flex-direction: column; gap: 0.4rem; border-top: 6px solid var(--pink); overflow: hidden; }
  .handout:nth-child(even) { border-top-color: var(--charcoal); }
  .handout--workbook { border-top-color: var(--pink-dark); background: var(--pink-tint); }
  .handout__num { position: absolute; right: 1rem; top: 0.25rem; font: 700 3rem var(--font-head); color: var(--pink-tint); }
  .handout--workbook .handout__num { color: #fff; }
  .handout h2 { margin: 0; font-size: 1.3rem; padding-right: 2.5rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-top: auto; padding-top: 0.5rem; }
  .actions .btn { padding: 0.5rem 1rem; font-size: 0.95rem; }
  .notes { font-weight: 700; margin-left: auto; }
  .small { font-size: 0.85rem; }
</style>
