---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import ExamSplit from '../components/ExamSplit.astro';
import { url } from '../lib/site';

const ISTQB_CTFL = 'https://istqb.org/certifications/certified-tester-foundation-level-ctfl-v4-0';

const kLevels = [
  { k: 'K1', name: 'Remember', desc: 'Recall a term or fact — e.g. "Which of the following is a typical test objective?"', mins: '1 min' },
  { k: 'K2', name: 'Understand', desc: 'Explain, compare or classify — e.g. pick the best description of a concept.', mins: '1-2 min' },
  { k: 'K3', name: 'Apply', desc: 'Use a technique on a scenario — e.g. work out boundary values or decision table coverage.', mins: '3 min' },
];
---
<BaseLayout title="Introduction to the ISTQB" description="What the ISTQB is, the Foundation Level certificate, and how the exam is structured and marked.">
  <PageHead eyebrow="Start here" title="Introduction to the ISTQB" />

  <div class="container intro">
    <section class="lead card">
      <h2>What is the ISTQB?</h2>
      <p>The <strong>International Software Testing Qualifications Board (ISTQB®)</strong> is a not-for-profit
        organisation, founded in 2002, that defines a common body of knowledge for software testers and certifies
        them against it. National member boards run the scheme in their own countries, so the same certificate is
        recognised by employers around the world.</p>
      <p>ISTQB writes the syllabi, the glossary of testing terms and the exam rules. Training providers such as
        Sparta Global teach the syllabus; the exams themselves are set by ISTQB and run by approved exam providers.</p>
    </section>

    <section>
      <h2 class="dot">The Foundation Level certificate</h2>
      <div class="grid">
        <div class="card">
          <span class="eyebrow">What it is</span>
          <h3>CTFL v4.0</h3>
          <p>The <strong>Certified Tester Foundation Level</strong> is the entry point to the ISTQB scheme and a
            prerequisite for the Advanced and Specialist certificates. Version 4.0 of the syllabus was released in 2023.</p>
        </div>
        <div class="card">
          <span class="eyebrow">Who it's for</span>
          <h3>Anyone in testing</h3>
          <p>Testers, test automation engineers, developers, business analysts and managers — anyone who needs a
            shared vocabulary and a solid grounding in how testing works.</p>
        </div>
        <div class="card">
          <span class="eyebrow">What it covers</span>
          <h3>Six chapters</h3>
          <p>Fundamentals, testing through the SDLC, static testing, test techniques, managing testing, and tools.
            <a href={url('chapters/1')}>Start the notes →</a></p>
        </div>
      </div>
    </section>

    <section>
      <h2 class="dot">The exam at a glance</h2>
      <div class="facts">
        <div class="fact card card--dark"><span class="fact__big">40</span><span>multiple-choice questions</span></div>
        <div class="fact card card--dark"><span class="fact__big">60</span><span>minutes, or 75 (+25%) if the exam isn't in your native language</span></div>
        <div class="fact card fact--pink"><span class="fact__big">26/40</span><span>to pass — a score of 65%</span></div>
        <div class="fact card card--dark"><span class="fact__big">1</span><span>point per question, whatever its difficulty</span></div>
      </div>
    </section>

    <section class="card">
      <h2>How the marks are granted</h2>
      <ul class="rules">
        <li><strong>One point per question.</strong> At Foundation Level every question is worth exactly one point, so
          a hard K3 calculation counts the same as a K1 definition. Wrong or blank answers simply score zero.</li>
        <li><strong>"Select ONE" or "Select TWO".</strong> Most questions have one correct option out of four. Some ask
          you to choose two out of five — you must get both right to earn the point.</li>
        <li><strong>65% to pass.</strong> You need at least 26 of the 40 points. There is no grading beyond pass or fail.</li>
        <li><strong>Everything in the syllabus is examinable.</strong> Every learning objective can be tested, and every
          keyword can be asked about at K2 (understanding its definition). A question may draw on more than one section.</li>
        <li><strong>A fixed split by chapter.</strong> Each exam has the same number of questions from each chapter (below), so
          Chapters 4 and 5 together make up half the paper.</li>
      </ul>
    </section>

    <section>
      <h2 class="dot">Knowledge levels (K-levels)</h2>
      <p class="muted">Every learning objective — and so every question — has a K-level. ISTQB gives a guide time for each.</p>
      <div class="grid">
        {kLevels.map((l) => (
          <div class="card klevel">
            <span class="klevel__k">{l.k}</span>
            <h3>{l.name}</h3>
            <p>{l.desc}</p>
            <span class="pill">Allow about {l.mins}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="card">
      <ExamSplit />
    </section>

    <section class="card numbering">
      <h2>How the notes follow the syllabus</h2>
      <p>The notes are organised exactly like the official <a href={ISTQB_CTFL} target="_blank" rel="noopener">ISTQB CTFL v4.0 syllabus</a>,
        using the same numbers — so you always know which part of the curriculum you're revising.</p>
      <div class="tree" aria-label="Example of the syllabus numbering">
        <div class="tree__row tree__row--1"><span class="tree__no">1</span><span><strong>Chapter</strong> · Fundamentals of Testing</span></div>
        <div class="tree__row tree__row--2"><span class="tree__no">1.1</span><span><strong>Section</strong> · What is Testing?</span></div>
        <div class="tree__row tree__row--3"><span class="tree__no">1.1.1</span><span><strong>Sub-section</strong> · Test Objectives</span></div>
        <div class="tree__row tree__row--3"><span class="tree__no">1.1.2</span><span><strong>Sub-section</strong> · Testing and Debugging</span></div>
        <div class="tree__row tree__row--2"><span class="tree__no">1.2</span><span><strong>Section</strong> · Why is Testing Necessary?</span></div>
      </div>
      <p>Every learning objective in the syllabus belongs to one of these sections, and the exam questions are written against them.</p>
      <h3>Where you'll see the numbers</h3>
      <ul class="where">
        <li><span class="demo demo--section">1.1 What is Testing?</span> <span>Each <strong>section</strong> of a chapter is a dark bar — open it to see its topics.</span></li>
        <li><span class="demo demo--chip">1.1.1</span> <span>Each <strong>topic</strong> shows the syllabus section it covers, so you can look it up in the syllabus.</span></li>
        <li><span class="demo demo--badge"><b>Syllabus</b> CTFL v4.0 · Section 1.1.1</span> <span>The badge at the top of each topic gives the full reference.</span></li>
        <li><span class="demo demo--syl">📘 What the syllabus says</span> <span>Opens the official syllabus wording for that topic.</span></li>
        <li><span class="demo demo--chip">Section 4.2.1</span> <span>Every quiz question shows the section it tests — handy for revising what you got wrong.</span></li>
      </ul>
    </section>

    <section class="card card--tint">
      <h2>How to use this site</h2>
      <ol class="steps">
        <li><strong>Read the chapter notes.</strong> Each topic shows the syllabus section it covers. Where a topic has a <strong>"What the syllabus says"</strong> box, it opens the wording taken
          directly from the official <a href={ISTQB_CTFL} target="_blank" rel="noopener">ISTQB CTFL v4.0 syllabus</a>. The
          exam is set against this text, so it's worth reading.</li>
        <li><strong>Take the end-of-chapter quiz.</strong> Each chapter's quiz uses the questions from <strong>ISTQB Sample Paper C</strong>
          that cover that chapter, so you answer the same number of questions the real exam asks on it. Answer them all, then
          submit to see your score and why each option is right or wrong.</li>
        <li><strong>Practise more on the same chapter.</strong> Every chapter also links to a practice set with all of its
          questions from <strong>Sample Papers A-D</strong>.</li>
        <li><strong>Sit a full sample paper.</strong> When you've covered all six chapters, try a complete 40-question paper
          against the clock in <a href={url('past-papers')}>Sample papers</a>.</li>
        <li><strong>Use the Resources menu.</strong> It holds everything that supports the notes:
          <ul class="res-list">
            <li><a href={url('handouts')}>Handouts</a>: a one-page summary for each chapter, plus the practice workbook with worked examples and exercises (PDF).</li>
            <li><a href="https://glossary.istqb.org/" target="_blank" rel="noopener">ISTQB glossary</a>: the official definitions of every testing term. Keywords are examinable, so look up any you're unsure of.</li>
            <li><a href="https://istqb.org/wp-content/uploads/2024/11/ISTQB_CTFL_Syllabus_v4.0.1.pdf" target="_blank" rel="noopener">ISTQB syllabus (PDF)</a>: the official CTFL v4.0.1 syllabus the exam is written against.</li>
          </ul>
        </li>
        <li><strong>Track your progress.</strong> Scores and completed chapters are saved in your browser on this device.</li>
      </ol>
    </section>

    <p class="source muted">Exam structure and rules: ISTQB® Exam Structures and Rules v1.2 and the CTFL v4.0 exam structure tables.
      The syllabus, glossary and sample papers are available from the <a href={ISTQB_CTFL} target="_blank" rel="noopener">ISTQB CTFL v4.0 page</a>.</p>
  </div>
</BaseLayout>

<style>
  .intro { display: grid; gap: 2.5rem; }
  .lead { border-left: 8px solid var(--pink); }
  .lead p:last-child { margin-bottom: 0; }
  .grid h3 { margin-top: 0.25rem; }
  .facts { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); }
  .fact { display: flex; flex-direction: column; gap: 0.25rem; }
  .fact__big { font: 700 2.75rem/1 var(--font-head); color: var(--pink-soft); }
  .fact--pink { background: var(--pink); color: #fff; }
  .fact--pink .fact__big { color: #fff; }
  .rules { display: grid; gap: 0.75rem; padding-left: 1.25rem; margin: 0; }
  .rules li::marker { color: var(--pink); }
  .klevel__k { font: 700 2rem var(--font-head); color: var(--pink); }
  .numbering { border-left: 8px solid var(--charcoal); }
  .tree { display: grid; gap: 0.35rem; margin: 1rem 0; padding: 1rem; background: var(--bg); border-radius: 12px; }
  .tree__row { display: flex; align-items: center; gap: 0.75rem; }
  .tree__row--2 { margin-left: 1.5rem; }
  .tree__row--3 { margin-left: 3rem; }
  .tree__no { flex: none; min-width: 3.2rem; text-align: center; padding: 0.15rem 0.5rem; border-radius: 999px; font-weight: 700; font-size: 0.85rem; }
  .tree__row--1 .tree__no { background: var(--charcoal); color: #fff; }
  .tree__row--2 .tree__no { background: var(--pink); color: #fff; }
  .tree__row--3 .tree__no { background: var(--surface); color: var(--pink-dark); border: 2px solid var(--pink-tint); }
  .numbering h3 { margin: 1.25rem 0 0.5rem; }
  .where { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .where li { display: grid; grid-template-columns: minmax(10rem, 15rem) 1fr; gap: 1rem; align-items: center; }
  .demo { justify-self: start; font-size: 0.85rem; font-weight: 700; border-radius: 8px; padding: 0.3rem 0.7rem; }
  .demo--section { background: var(--charcoal); color: #fff; border-left: 5px solid var(--pink); font-family: var(--font-head); }
  .demo--chip { background: var(--bg); color: var(--grey); border-radius: 999px; }
  .demo--badge { color: var(--grey); padding-left: 0; }
  .demo--badge b { background: var(--pink); color: #fff; padding: 0.1rem 0.5rem; border-radius: 999px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; margin-right: 0.35rem; }
  .demo--syl { background: var(--surface); color: var(--charcoal); border-left: 4px solid var(--charcoal); box-shadow: var(--shadow); }
  @media (max-width: 40rem) {
    .where li { grid-template-columns: 1fr; gap: 0.3rem; }
    .tree__row--2 { margin-left: 0.75rem; }
    .tree__row--3 { margin-left: 1.5rem; }
  }
  .res-list { margin: 0.4rem 0 0; padding-left: 1.1rem; display: grid; gap: 0.3rem; font-size: 0.95rem; }
  .steps { display: grid; gap: 0.6rem; padding-left: 1.25rem; }
  .source { font-size: 0.85rem; }
</style>
